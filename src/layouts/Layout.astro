---
interface Props {
  title?: string;
  description?: string;
}

const { 
  title = "Earthware — Ceramic Pot Website", 
  description = "Feel it, Feel the Uniqueness. Is filament of the highest quality that we are proud to offer our customers." 
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <title>{title}</title>
  <meta name="description" content={description}>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,400&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400&family=Just+Me+Again+Down+Here&display=swap" rel="stylesheet">

  <link rel="stylesheet" href="/assets/css/style.css">
</head>
<body class="bg-white text-[#000104] antialiased min-h-screen overflow-x-hidden w-full">
  <slot />

  <!-- Modular MVVM Application Client Script -->
  <script type="module" src="/src/app.js"></script>
</body>
</html>


---
// Categories.astro - Instant Zero-Latency Render with Client Hydration
import { categoriesData } from '../data/mockData.js';
const displayCategories = categoriesData;
---

<section id="categories" class="py-16 lg:py-20 bg-white border-b border-neutral-200/60 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <div>
        <h2 class="font-gallient text-4xl sm:text-6xl text-[#000104] font-normal">Categories</h2>
      </div>
      <p class="text-base sm:text-lg text-[#5E666C] max-w-xl">
        3DO Filament (Made in EU) is properly one of the best filaments you will find out there, we are using the best raw materials and have a very strict quality control.
      </p>
    </div>

    <!-- Categories Container: Grid on Mobile (2 columns), Carousel on Desktop -->
    <div class="relative">
      <div id="categories-grid-container" class="grid grid-cols-2 sm:grid-cols-3 lg:flex lg:flex-nowrap gap-4 sm:gap-6 lg:overflow-x-auto pb-4 lg:pb-6 hide-scrollbar scroll-smooth">
        {displayCategories.map((cat, index) => {
          const isSelected = index === 0;
          const cardBgClass = isSelected ? 'bg-[#EDEDED]' : 'bg-white border border-neutral-200/80';
          const imgSrc = cat.image.startsWith('/') ? cat.image : `/${cat.image}`;

          return (
            <div 
              onclick={`window.location.href='/product?id=${cat.id}'`}
              class="w-full lg:w-[230px] lg:flex-shrink-0 flex flex-col group cursor-pointer relative"
            >
              <!-- Card Image Container -->
              <div class={`h-[200px] sm:h-[250px] lg:h-[290px] w-full rounded-2xl ${cardBgClass} flex items-center justify-center overflow-hidden relative card-hover transition-transform duration-300 group-hover:shadow-md p-3`}>
                {isSelected && (
                  <div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-white absolute pointer-events-none shadow-sm"></div>
                )}
                <img 
                  src={imgSrc} 
                  alt={cat.name} 
                  class="h-28 sm:h-36 lg:h-40 max-w-[85%] object-contain relative z-10 group-hover:scale-105 transition-smooth"
                />
              </div>

              <!-- Title & Price (Under the Box) -->
              <div class="pt-2 sm:pt-3 flex flex-col items-start">
                <h4 class="font-bold text-sm sm:text-base lg:text-[18px] text-[#000104] group-hover:text-neutral-700 transition-colors">
                  {cat.name}
                </h4>
                <span class="text-xs sm:text-[15px] font-medium text-[#5E666C] mt-0.5">
                  PKR {cat.price}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Carousel Right Arrow (Only on Desktop Carousel) -->
      <button 
        id="cat-scroll-right-btn" 
        class="hidden lg:flex absolute right-0 top-1/2 -translate-y-8 w-12 h-12 rounded-full bg-white shadow-xl border border-neutral-200 items-center justify-center text-neutral-800 z-30 hover:scale-110 transition-smooth btn-press" 
        aria-label="Next Category"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
      </button>
    </div>
  </div>
</section>

<script>
  import { getHomeCarouselProducts } from '../services/dbService.js';
  const container = document.getElementById('categories-grid-container');
  const scrollRightBtn = document.getElementById('cat-scroll-right-btn');

  if (scrollRightBtn && container) {
    scrollRightBtn.addEventListener('click', () => {
      container.scrollBy({ left: 300, behavior: 'smooth' });
    });
  }

  // Live dynamic hydration from Supabase
  getHomeCarouselProducts().then((liveCats: any[]) => {
    if (liveCats && liveCats.length > 0 && container) {
      container.innerHTML = '';
      liveCats.forEach((cat: any, index: number) => {
        const isSelected = index === 0;
        const cardBgClass = isSelected ? 'bg-[#EDEDED]' : 'bg-white border border-neutral-200/80';
        const imgSrc = cat.image && cat.image.startsWith('/') ? cat.image : (cat.image ? `/${cat.image}` : '/assets/images/cat-river-vase.png');
        const div = document.createElement('div');
        div.className = 'w-full lg:w-[230px] lg:flex-shrink-0 flex flex-col group cursor-pointer relative';
        div.onclick = () => window.location.href = `/product?id=${cat.id}`;
        div.innerHTML = `
          <div class="h-[200px] sm:h-[250px] lg:h-[290px] w-full rounded-2xl ${cardBgClass} flex items-center justify-center overflow-hidden relative card-hover transition-transform duration-300 group-hover:shadow-md p-3">
            ${isSelected ? '<div class="w-32 h-32 sm:w-40 sm:h-40 rounded-full bg-white absolute pointer-events-none shadow-sm"></div>' : ''}
            <img src="${imgSrc}" alt="${cat.name}" class="h-28 sm:h-36 lg:h-40 max-w-[85%] object-contain relative z-10 group-hover:scale-105 transition-smooth" />
          </div>
          <div class="pt-2 sm:pt-3 flex flex-col items-start">
            <h4 class="font-bold text-sm sm:text-base lg:text-[18px] text-[#000104] group-hover:text-neutral-700 transition-colors">
              ${cat.name}
            </h4>
            <span class="text-xs sm:text-[15px] font-medium text-[#5E666C] mt-0.5">
              PKR ${Number(cat.price || 0).toLocaleString()}
            </span>
          </div>
        `;
        container.appendChild(div);
      });
    }
  }).catch(() => {});
</script>


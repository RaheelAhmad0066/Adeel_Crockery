---
// Categories.astro - Exact Figma layout matching Image 3
import { categoriesData } from '../data/mockData.js';
---

<section id="categories" class="py-16 lg:py-20 bg-white border-b border-neutral-200/60 overflow-hidden">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-6">
      <div>
        <h2 class="font-gallient text-4xl sm:text-6xl text-[#000104] font-normal">Categories</h2>
      </div>
      <p class="text-base sm:text-lg text-[#5E666C] max-w-xl">
        3DO Filament (Made in EU) is properly one of the best filaments you will find out there, we are using the best raw materials and have a very strict quality control.
      </p>
    </div>

    <!-- Categories Container with Right Arrow -->
    <div class="relative">
      <div id="categories-grid-container" class="flex gap-6 overflow-x-auto pb-6 hide-scrollbar scroll-smooth">
        {categoriesData.map((cat, index) => {
          const isSelected = index === 0;
          const cardBgClass = isSelected ? 'bg-[#EDEDED]' : 'bg-white border border-neutral-200/80';
          const imgSrc = cat.image.startsWith('/') ? cat.image : `/${cat.image}`;

          return (
            <div 
              onclick={`window.location.href='/product?id=${cat.id}'`}
              class="w-[230px] flex-shrink-0 flex flex-col group cursor-pointer relative"
            >
              <!-- Card Image Container -->
              <div class={`h-[290px] w-full rounded-2xl ${cardBgClass} flex items-center justify-center overflow-hidden relative card-hover transition-transform duration-300 group-hover:shadow-md`}>
                {isSelected && (
                  <div class="w-40 h-40 rounded-full bg-white absolute pointer-events-none shadow-sm"></div>
                )}
                <img 
                  src={imgSrc} 
                  alt={cat.name} 
                  class="h-40 max-w-[85%] object-contain relative z-10 group-hover:scale-105 transition-smooth"
                />
              </div>

              <!-- Title & Price (Under the Box) -->
              <div class="pt-3 flex flex-col items-start">
                <h4 class="font-bold text-[18px] text-[#000104] group-hover:text-neutral-700 transition-colors">
                  {cat.name}
                </h4>
                <span class="text-[15px] font-medium text-[#5E666C] mt-0.5">
                  ${cat.price}
                </span>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Carousel Right Arrow -->
      <button 
        id="cat-scroll-right-btn" 
        class="absolute right-0 top-1/2 -translate-y-8 w-12 h-12 rounded-full bg-white shadow-xl border border-neutral-200 flex items-center justify-center text-neutral-800 z-30 hover:scale-110 transition-smooth btn-press" 
        aria-label="Next Category"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>
    </div>
  </div>
</section>

---
// BrandPartners.astro
---

<section class="bg-earth-olive py-14 sm:py-18 border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 text-center space-y-8">
    <h3 class="font-gallient text-3xl sm:text-4xl text-[#000104] font-normal">
      They trusted us
    </h3>
    
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8 lg:gap-14 items-center justify-items-center max-w-4xl mx-auto">
      <div class="p-2 hover:scale-105 transition-smooth cursor-pointer">
        <img src="/assets/icons/brand-cerim.svg" alt="CERIM" class="h-8 sm:h-9 w-auto object-contain">
      </div>
      <div class="p-2 hover:scale-105 transition-smooth cursor-pointer">
        <img src="/assets/icons/brand-azteca.svg" alt="AZTECA Ceramica" class="h-8 sm:h-9 w-auto object-contain">
      </div>
      <div class="p-2 hover:scale-105 transition-smooth cursor-pointer">
        <img src="/assets/icons/brand-ragno.svg" alt="CERAMICHE RAGNO" class="h-8 sm:h-9 w-auto object-contain">
      </div>
      <div class="p-2 hover:scale-105 transition-smooth cursor-pointer">
        <img src="/assets/icons/brand-venus.svg" alt="VENUS CERAMICA" class="h-8 sm:h-9 w-auto object-contain">
      </div>
    </div>
  </div>
</section>


---
// Footer.astro
---

<footer class="bg-[#000104] text-neutral-300 py-16">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10">
    <div class="space-y-4">
      <img src="/assets/images/logo-white.png" alt="Earthware" class="h-8 w-auto object-contain">
      <p class="text-sm text-[#888888] leading-relaxed max-w-[209px]">
        The fastest, most precise No-Code AI tool in the world.
      </p>
      <p class="text-xs text-[#888888]">©2024 earthware, Inc.</p>
      <div class="pt-2">
        <span class="block text-sm font-semibold text-white mb-2">Follow Us</span>
        <div class="flex items-center gap-3">
          <span class="w-7 h-7 rounded-full bg-[#F0F2E5] flex items-center justify-center text-[#000104] text-xs font-bold cursor-pointer hover:opacity-80">f</span>
          <span class="w-7 h-7 rounded-full bg-[#F0F2E5] flex items-center justify-center text-[#000104] text-xs font-bold cursor-pointer hover:opacity-80">in</span>
          <span class="w-7 h-7 rounded-full bg-[#F0F2E5] flex items-center justify-center text-[#000104] text-xs font-bold cursor-pointer hover:opacity-80">wa</span>
        </div>
      </div>
    </div>

    <div class="space-y-3">
      <h4 class="text-base font-semibold text-white">Product</h4>
      <ul class="space-y-2 text-sm text-[#888888]">
        <li><a href="#" class="hover:text-white transition-colors">FAQ</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Personal Data Policy</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Terms Of Service</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Cookie and Privacy Policy</a></li>
      </ul>
    </div>

    <div class="space-y-3">
      <h4 class="text-base font-semibold text-white">Resources</h4>
      <ul class="space-y-2 text-sm text-[#888888]">
        <li class="text-white font-medium">3DO</li>
        <li>Platanvej 10, 7400 Herning</li>
        <li>(+45) 93 40 44 31</li>
        <li><a href="mailto:info@3do.dk" class="hover:text-white transition-colors">info@3do.dk</a></li>
      </ul>
    </div>

    <div class="space-y-3">
      <h4 class="text-base font-semibold text-white">Company</h4>
      <ul class="space-y-2 text-sm text-[#888888]">
        <li><a href="/about" class="hover:text-white transition-colors">About</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Careers</a></li>
        <li><a href="#" class="hover:text-white transition-colors">Contact Us</a></li>
      </ul>
    </div>
  </div>
</footer>


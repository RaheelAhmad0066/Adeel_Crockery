---
// Newsletter.astro
---

<section class="bg-earth-olive py-16 relative overflow-hidden">
  <img 
    src="/assets/icons/tag icon.svg" 
    alt="" 
    class="absolute left-[-60px] top-1/2 -translate-y-1/2 h-[350px] w-auto opacity-80 pointer-events-none hidden sm:block"
  >

  <div class="max-w-[736px] mx-auto px-4 sm:px-6 text-center space-y-4 sm:space-y-5 relative z-10">
    <h2 class="font-gallient text-3xl sm:text-6xl text-[#000104] font-normal">Join Our Newsletter</h2>
    <p class="text-xs sm:text-base text-[#5E666C] leading-relaxed max-w-lg mx-auto">
      Join our email subscription now to get updates on promotions and coupons. Special PKR discount on your first order.
    </p>

    <form id="newsletter-form" class="max-w-[588px] mx-auto h-[54px] sm:h-[64px] bg-white rounded-full p-1.5 sm:p-2 flex items-center justify-between shadow-sm border border-neutral-200">
      <input 
        id="newsletter-email" 
        type="email" 
        required 
        placeholder="Your Email" 
        class="flex-1 min-w-0 px-3 sm:px-6 bg-transparent text-[#000104] focus:outline-none text-xs sm:text-base placeholder:text-neutral-400"
      >
      <button type="submit" class="bg-[#000104] text-white font-semibold text-xs sm:text-base px-4 sm:px-8 h-full rounded-full hover:bg-neutral-800 transition-smooth btn-press flex-shrink-0">
        Subscribe
      </button>
    </form>
    <div id="newsletter-msg" class="hidden text-xs sm:text-sm font-medium text-green-700">
      Thank you for subscribing! Your discount code has been sent.
    </div>
  </div>
</section>


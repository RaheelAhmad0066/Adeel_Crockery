---
// CartDrawer.astro
---

<!-- Background Overlay -->
<div id="cart-overlay" class="fixed inset-0 bg-black/60 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>

<!-- Slide-out Drawer -->
<aside id="cart-drawer" class="fixed top-0 right-0 h-full w-full sm:w-[420px] bg-white z-50 shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col justify-between">
  <!-- Header -->
  <div class="p-6 border-b border-[#E8E8E8] flex items-center justify-between">
    <div class="flex items-center gap-2">
      <h3 class="text-2xl font-gallient text-[#000104]">Your Cart</h3>
      <span class="cart-count-badge bg-[#000104] text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold">0</span>
    </div>
    <button id="close-cart-btn" class="p-2 text-[#5E666C] hover:text-[#000104]" aria-label="Close cart">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Items list (Hydrated reactively by CartViewModel) -->
  <div id="cart-items-container" class="p-6 overflow-y-auto space-y-4 flex-1">
  </div>

  <!-- Summary & Checkout -->
  <div class="p-6 bg-[#FAF8F5] border-t border-[#E8E8E8] space-y-2.5">
    <div class="flex justify-between text-sm text-[#5E666C]">
      <span>Subtotal</span>
      <span id="cart-subtotal" class="font-semibold text-[#000104]">PKR 0</span>
    </div>
    <div class="flex justify-between text-sm text-green-700">
      <span>Discount</span>
      <span id="cart-discount">PKR 0</span>
    </div>
    <div class="flex justify-between text-sm text-[#5E666C]">
      <span>VAT (16%)</span>
      <span id="cart-vat" class="font-semibold text-[#000104]">PKR 0</span>
    </div>
    <div class="flex justify-between text-lg font-bold text-[#000104] pt-2 border-t border-neutral-200">
      <span>Total</span>
      <span id="cart-total">PKR 0</span>
    </div>
    <a id="checkout-order-btn" href="/checkout" class="block w-full text-center bg-[#000104] text-white font-semibold py-3.5 rounded-md mt-3 hover:bg-neutral-800 transition-smooth shadow-md btn-press">
      Place Order
    </a>
  </div>
</aside>


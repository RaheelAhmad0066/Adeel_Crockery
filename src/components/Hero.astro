---
// Hero.astro - Instant Zero-Latency Render with Client Hydration
const defaultBanner = {
  headline: "Feel it, Feel the Uniqueness.",
  subtitle: "Is filament of the highest quality that we are proud to offer our customers.",
  cta_text: "Buy Now",
  cta_link: "#products",
  image: "/assets/images/hero-pot.png"
};
---


<section id="hero-banner-section" class="relative overflow-hidden py-16 sm:py-24 border-b border-neutral-200/50 bg-[#FBF6F3]">
  <!-- Exact Background Image: assets/images/Hero Section.svg (Permanent) -->
  <img 
    src="/assets/images/Hero Section.svg" 
    alt="" 
    class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-90"
  >
  
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 text-center relative z-10 space-y-7">
    <h1 id="hero-headline" class="font-gallient text-4xl sm:text-6xl md:text-7xl lg:text-[80px] leading-[1.08] font-normal text-[#000104] tracking-tight max-w-4xl mx-auto">
      {defaultBanner.headline}
    </h1>

    <p id="hero-subtitle" class="text-lg sm:text-2xl text-[#5E666C] font-normal max-w-2xl mx-auto leading-relaxed">
      {defaultBanner.subtitle}
    </p>

    <div class="pt-2">
      <a 
        id="hero-cta" 
        href={defaultBanner.cta_link} 
        class="inline-block bg-[#000104] text-white text-[18px] font-semibold px-11 py-4 rounded-md hover:bg-neutral-800 transition-smooth shadow-md btn-press"
      >
        {defaultBanner.cta_text}
      </a>
    </div>

    <!-- Carousel Indicators for Multiple Slides -->
    <div id="hero-indicators" class="pt-4 flex items-center justify-center gap-2"></div>

    <div class="pt-6 max-w-xl mx-auto flex justify-center animate-float">
      <img 
        id="hero-img"
        src={defaultBanner.image} 
        alt="Ceramic Pottery" 
        class="max-h-[340px] w-auto drop-shadow-xl object-contain transition-opacity duration-700"
      >
    </div>
  </div>
</section>

<script>
  import { getActiveHeroBanners } from '../services/dbService.js';
  
  let currentSlideIndex = 0;
  let slideTimer: any = null;
  let bannerSlides: any[] = [];

  function displaySlide(index: number) {
    if (!bannerSlides || bannerSlides.length === 0) return;
    const slide = bannerSlides[index];
    if (!slide) return;

    const hEl = document.getElementById('hero-headline');
    const sEl = document.getElementById('hero-subtitle');
    const cEl = document.getElementById('hero-cta') as HTMLAnchorElement;
    const iEl = document.getElementById('hero-img') as HTMLImageElement;

    // Smooth subtle transition
    if (hEl) {
      hEl.style.opacity = '0';
      setTimeout(() => {
        hEl.textContent = slide.headline || '';
        hEl.style.opacity = '1';
      }, 200);
    }
    if (sEl) {
      sEl.style.opacity = '0';
      setTimeout(() => {
        sEl.textContent = slide.subtitle || '';
        sEl.style.opacity = '1';
      }, 200);
    }
    if (cEl) {
      cEl.textContent = slide.cta_text || 'Buy Now';
      cEl.href = slide.cta_link || '#products';
    }
    if (iEl) {
      iEl.style.opacity = '0';
      setTimeout(() => {
        iEl.src = slide.image || '/assets/images/hero-pot.png';
        iEl.style.opacity = '1';
      }, 200);
    }

    // Update dots
    const dots = document.querySelectorAll('.hero-dot');
    dots.forEach((dot, dIdx) => {
      if (dIdx === index) {
        dot.className = 'hero-dot w-6 h-2 rounded-full bg-[#000104] transition-all duration-300';
      } else {
        dot.className = 'hero-dot w-2 h-2 rounded-full bg-neutral-300 hover:bg-neutral-500 transition-all duration-300';
      }
    });
  }

  function startAutoSlide() {
    if (slideTimer) clearInterval(slideTimer);
    if (bannerSlides.length > 1) {
      slideTimer = setInterval(() => {
        currentSlideIndex = (currentSlideIndex + 1) % bannerSlides.length;
        displaySlide(currentSlideIndex);
      }, 4500); // Auto slide every 4.5 seconds
    }
  }

    getActiveHeroBanners().then((banners) => {
    if (banners && banners.length > 0) {
      bannerSlides = banners.filter((b: any) => b.is_active !== false);
      if (bannerSlides.length === 0) bannerSlides = banners;

      // Update hero image and content immediately without fade delay on first hydration
      const first = bannerSlides[0];
      const hEl = document.getElementById('hero-headline');
      const sEl = document.getElementById('hero-subtitle');
      const cEl = document.getElementById('hero-cta') as HTMLAnchorElement;
      const iEl = document.getElementById('hero-img') as HTMLImageElement;
      if (first) {
        if (hEl && first.headline) hEl.textContent = first.headline;
        if (sEl && first.subtitle) sEl.textContent = first.subtitle;
        if (cEl) {
          cEl.textContent = first.cta_text || 'Buy Now';
          cEl.href = first.cta_link || '#products';
        }
        if (iEl && first.image) {
          iEl.src = first.image;
        }
      }

      // Render dots if more than 1 banner
      const indicatorsContainer = document.getElementById('hero-indicators');
      if (indicatorsContainer && bannerSlides.length > 1) {
        indicatorsContainer.innerHTML = '';
        bannerSlides.forEach((_, idx) => {
          const dot = document.createElement('button');
          dot.className = `hero-dot ${idx === 0 ? 'w-6 bg-[#000104]' : 'w-2 bg-neutral-300'} h-2 rounded-full transition-all duration-300`;
          dot.onclick = () => {
            currentSlideIndex = idx;
            displaySlide(currentSlideIndex);
            startAutoSlide(); // reset timer on manual click
          };
          indicatorsContainer.appendChild(dot);
        });
      }

      startAutoSlide();
    }
  }).catch((err) => {
    console.warn('Hero live banners warning:', err);
  });
</script>


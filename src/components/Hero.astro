---
// Hero.astro
---

<section class="relative overflow-hidden py-16 sm:py-24 border-b border-neutral-200/50 bg-[#FBF6F3]">
  <!-- Exact Background Image: assets/images/Hero Section.svg -->
  <img 
    src="/assets/images/Hero Section.svg" 
    alt="" 
    class="absolute inset-0 w-full h-full object-cover pointer-events-none"
  >
  
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 text-center relative z-10 space-y-7">
    <h1 class="font-gallient text-4xl sm:text-6xl md:text-7xl lg:text-[80px] leading-[1.08] font-normal text-[#000104] tracking-tight max-w-4xl mx-auto">
      Feel it, Feel the Uniqueness.
    </h1>

    <p class="text-lg sm:text-2xl text-[#5E666C] font-normal max-w-2xl mx-auto leading-relaxed">
      Is filament of the highest quality that we are proud to offer our customers.
    </p>

    <div class="pt-2">
      <a href="#products" class="inline-block bg-[#000104] text-white text-[18px] font-semibold px-11 py-4 rounded-md hover:bg-neutral-800 transition-smooth shadow-md btn-press">
        Buy Now
      </a>
    </div>

    <div class="pt-6 max-w-xl mx-auto flex justify-center animate-float">
      <img 
        src="/assets/images/hero-pot.png" 
        alt="Ceramic Jugs" 
        class="max-h-[340px] w-auto drop-shadow-xl object-contain"
      >
    </div>
  </div>
</section>


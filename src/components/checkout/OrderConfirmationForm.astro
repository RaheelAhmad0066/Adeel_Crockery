---
// src/components/checkout/OrderConfirmationForm.astro - Delivery Address, Payment & Swipe/Drag to Confirm
---

<div id="screen-checkout" class="space-y-6">
  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Left Column: Address & Payment Details (7 cols) -->
    <div class="lg:col-span-7 space-y-6">

      <!-- 1. Delivery Address Card -->
      <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-sm space-y-4">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="p-2 bg-[#F4EBE1] text-[#000104] rounded-lg">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </span>
            <div>
              <h3 class="font-bold text-sm sm:text-base text-[#000104]">Delivery Address</h3>
              <p class="text-xs text-[#5E666C]">Rider will deliver here</p>
            </div>
          </div>
          <button id="edit-address-btn" class="text-xs font-semibold text-[#000104] hover:underline underline-offset-2">
            Edit Address
          </button>
        </div>

        <!-- Current Address Preview -->
        <div id="address-preview" class="p-4 bg-[#FAF8F5] rounded-xl border border-neutral-200/60 text-xs text-[#4A4F54] space-y-1">
          <p class="font-bold text-[#000104] text-sm" id="addr-name">Adeel Crockery Store Customer</p>
          <p id="addr-line1">House # 42, Street 8, Sector F-7/2</p>
          <p id="addr-city">Islamabad, Pakistan</p>
          <p id="addr-phone" class="text-neutral-500 font-medium">📞 +92 300 1234567</p>
        </div>

        <!-- Address Edit Form (hidden by default) -->
        <div id="address-edit-box" class="hidden space-y-3 pt-2 border-t border-neutral-200">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
            <input type="text" id="input-name" placeholder="Full Name" value="Adeel Crockery Customer" class="w-full text-xs p-2.5 bg-[#FAF8F5] border border-neutral-300 rounded-lg focus:outline-none focus:border-black" />
            <input type="text" id="input-phone" placeholder="Phone Number" value="+92 300 1234567" class="w-full text-xs p-2.5 bg-[#FAF8F5] border border-neutral-300 rounded-lg focus:outline-none focus:border-black" />
          </div>
          <input type="text" id="input-street" placeholder="Street Address / House #" value="House # 42, Street 8, Sector F-7/2" class="w-full text-xs p-2.5 bg-[#FAF8F5] border border-neutral-300 rounded-lg focus:outline-none focus:border-black" />
          <div class="grid grid-cols-2 gap-3">
            <input type="text" id="input-city" placeholder="City" value="Islamabad" class="w-full text-xs p-2.5 bg-[#FAF8F5] border border-neutral-300 rounded-lg focus:outline-none focus:border-black" />
            <input type="text" id="input-instructions" placeholder="Note for rider (Optional)" value="Ring the bell on gate" class="w-full text-xs p-2.5 bg-[#FAF8F5] border border-neutral-300 rounded-lg focus:outline-none focus:border-black" />
          </div>
          <div class="flex justify-end gap-2 pt-1">
            <button type="button" id="cancel-addr-btn" class="px-3 py-1.5 text-xs text-neutral-600 hover:text-black">Cancel</button>
            <button type="button" id="save-addr-btn" class="px-4 py-1.5 bg-[#000104] text-white rounded-md text-xs font-semibold">Save Address</button>
          </div>
        </div>
      </div>

      <!-- 2. Payment Method: Cash On Delivery -->
      <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-sm space-y-4">
        <div class="flex items-center gap-2.5">
          <span class="p-2 bg-[#F4EBE1] text-[#000104] rounded-lg">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
          </span>
          <div>
            <h3 class="font-bold text-sm sm:text-base text-[#000104]">Payment Method</h3>
            <p class="text-xs text-[#5E666C]">Pay when rider delivers to your doorstep</p>
          </div>
        </div>

        <label class="flex items-center justify-between p-4 rounded-xl border-2 border-black bg-[#FAF8F5] cursor-pointer">
          <div class="flex items-center gap-3">
            <input type="radio" name="payment" value="cod" checked class="w-4 h-4 text-black accent-black" />
            <div>
              <span class="text-xs sm:text-sm font-bold text-[#000104] block">Cash on Delivery (COD)</span>
              <span class="text-[11px] text-[#5E666C]">Pay in cash at the time of delivery</span>
            </div>
          </div>
          <span class="text-xs font-semibold text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded">Active</span>
        </label>
      </div>

    </div>

    <!-- Right Column: Order Summary & DRAG TO CONFIRM (5 cols) -->
    <div class="lg:col-span-5 space-y-6">
      <div class="bg-white rounded-2xl p-6 sm:p-7 border border-neutral-200/60 shadow-sm space-y-5">
        <h3 class="font-bold text-sm sm:text-base text-[#000104]">Order Summary</h3>

        <!-- Cart items dynamically injected -->
        <div id="checkout-items-list" class="space-y-3 max-h-60 overflow-y-auto divide-y divide-neutral-100">
        </div>

        <!-- Price Details -->
        <div class="space-y-2 pt-3 border-t border-neutral-200 text-xs text-[#5E666C]">
          <div class="flex justify-between">
            <span>Subtotal</span>
            <span id="co-subtotal" class="font-semibold text-[#000104]">$0.00</span>
          </div>
          <div class="flex justify-between text-emerald-700">
            <span>Discount</span>
            <span id="co-discount">-$0.00</span>
          </div>
          <div class="flex justify-between">
            <span>Delivery Fee</span>
            <span class="font-semibold text-[#000104]">$0.00 (FREE)</span>
          </div>
          <div class="flex justify-between">
            <span>VAT (16%)</span>
            <span id="co-vat" class="font-semibold text-[#000104]">$0.00</span>
          </div>
          <div class="flex justify-between text-base font-bold text-[#000104] pt-2 border-t border-neutral-200">
            <span>Total Amount</span>
            <span id="co-total">$0.00</span>
          </div>
        </div>

        <!-- ================= SWIPE / DRAG TO CONFIRM ORDER BUTTON ================= -->
        <div class="pt-2 space-y-2">
          <div class="text-center">
            <span class="text-[11px] font-semibold text-neutral-500 uppercase tracking-wider">Drag Slider to Place Order</span>
          </div>

          <div id="slider-track" class="relative w-full h-14 bg-neutral-100 rounded-full p-1.5 flex items-center select-none overflow-hidden border border-neutral-300 shadow-inner">
            <div id="slider-fill" class="absolute top-0 left-0 h-full bg-[#000104] w-14 rounded-full transition-all duration-75"></div>
            
            <span id="slider-text" class="absolute inset-0 flex items-center justify-center text-xs font-bold text-neutral-500 pointer-events-none tracking-wide">
              Slide to Confirm Order →
            </span>

            <div id="slider-knob" class="relative z-10 w-11 h-11 bg-[#000104] text-white rounded-full flex items-center justify-center cursor-grab active:cursor-grabbing shadow-lg hover:scale-105 transition-transform">
              <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
            </div>
          </div>
        </div>

      </div>
    </div>

  </div>
</div>


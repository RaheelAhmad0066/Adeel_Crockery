---
// src/components/checkout/LiveTrackerMap.astro - Google Maps & Live Rider Info Card
---

<div id="screen-tracking" class="hidden space-y-6">
  
  <!-- Live Status Banner -->
  <div class="bg-[#000104] text-white rounded-2xl p-6 sm:p-7 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 shadow-lg">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-xs uppercase tracking-wider font-semibold text-emerald-400">Rider on the way</span>
      </div>
      <h3 class="font-gallient text-2xl sm:text-3xl text-white">Estimated Arrival: <span id="eta-text">14 mins</span></h3>
      <p class="text-xs text-neutral-400">Rider picked up your Crockery parcel from Earthware Workshop</p>
    </div>

    <div class="flex items-center gap-3">
      <a href="tel:+923129876543" class="flex items-center gap-2 bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-4 py-3 rounded-xl transition-colors shadow">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
        <span>Call Rider</span>
      </a>
      <button id="simulate-delivered-btn" class="bg-neutral-800 hover:bg-neutral-700 text-white text-xs px-3.5 py-3 rounded-xl transition-colors">
        Simulate Delivery ✓
      </button>
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
    
    <!-- Interactive Google Map Canvas (8 cols) -->
    <div class="lg:col-span-8 bg-white rounded-3xl p-4 sm:p-6 border border-neutral-200/60 shadow-sm space-y-4">
      
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <span class="w-3 h-3 rounded-full bg-emerald-500"></span>
          <span class="text-xs font-bold text-[#000104] uppercase tracking-wide">Live GPS Tracker (Google Maps)</span>
        </div>
        <span id="speed-meter" class="text-xs font-mono text-neutral-500">Speed: 36 km/h</span>
      </div>

      <!-- Google Maps Realtime Canvas -->
      <div class="relative w-full h-[380px] sm:h-[450px] bg-[#E9E5DC] rounded-2xl overflow-hidden border border-neutral-300 shadow-inner">
        <div id="google-map" class="w-full h-full"></div>

        <!-- Live Overlay Pill -->
        <div class="absolute top-3 left-3 bg-white/95 backdrop-blur-md px-3.5 py-1.5 rounded-full text-xs font-semibold text-neutral-800 shadow-md border border-neutral-200 flex items-center gap-2 z-10">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Live Polyline Tracking</span>
        </div>

        <!-- Distance & ETA Card -->
        <div class="absolute bottom-3 right-3 bg-white/95 backdrop-blur-md p-3 rounded-xl shadow-lg border border-neutral-200 z-10 space-y-1 text-xs">
          <div class="flex items-center gap-3">
            <div>
              <span class="text-[10px] text-neutral-400 block font-medium">REMAINING DISTANCE</span>
              <span id="map-dist-text" class="font-bold text-[#000104]">2.8 km</span>
            </div>
            <div class="w-[1px] h-6 bg-neutral-200"></div>
            <div>
              <span class="text-[10px] text-neutral-400 block font-medium">ESTIMATED TIME</span>
              <span id="map-eta-badge" class="font-bold text-emerald-600">14 mins</span>
            </div>
          </div>
        </div>
      </div>

    </div>

    <!-- Rider Profile & Contact Card (4 cols) -->
    <div class="lg:col-span-4 space-y-6">
      <div class="bg-white rounded-3xl p-6 sm:p-7 border border-neutral-200/60 shadow-sm space-y-5">
        
        <div class="flex items-center gap-3.5">
          <div class="w-14 h-14 rounded-full bg-neutral-100 border-2 border-emerald-500 overflow-hidden flex items-center justify-center text-2xl">
            👨‍✈️
          </div>
          <div>
            <h4 class="font-bold text-sm sm:text-base text-[#000104]">Tariq Mehmood</h4>
            <div class="flex items-center gap-1 text-amber-500 text-xs font-semibold">
              <span>★ 4.9</span>
              <span class="text-neutral-400 font-normal">(520+ deliveries)</span>
            </div>
            <span class="text-[11px] text-emerald-700 font-medium bg-emerald-50 px-2 py-0.5 rounded inline-block mt-0.5">Verified Foodpanda Rider</span>
          </div>
        </div>

        <div class="p-3.5 bg-[#FAF8F5] rounded-xl border border-neutral-200/60 space-y-2 text-xs">
          <div class="flex justify-between">
            <span class="text-[#5E666C]">Rider Phone:</span>
            <a href="tel:+923129876543" class="font-bold text-[#000104] hover:underline">+92 312 9876543</a>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5E666C]">Vehicle:</span>
            <span class="font-bold text-[#000104]">Honda 125 (ICT-904)</span>
          </div>
          <div class="flex justify-between">
            <span class="text-[#5E666C]">Parcel Safety:</span>
            <span class="font-bold text-emerald-700">Fragile Handled With Care</span>
          </div>
        </div>

        <div class="space-y-2">
          <a href="tel:+923129876543" class="w-full bg-[#000104] hover:bg-neutral-800 text-white font-semibold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/></svg>
            <span>Call Rider (+92 312 9876543)</span>
          </a>
          <a href="https://wa.me/923129876543" target="_blank" class="w-full bg-[#25D366] hover:bg-[#20ba59] text-white font-semibold text-xs py-3 rounded-xl flex items-center justify-center gap-2 transition-colors">
            <span>Chat on WhatsApp</span>
          </a>
        </div>

      </div>
    </div>

  </div>

</div>


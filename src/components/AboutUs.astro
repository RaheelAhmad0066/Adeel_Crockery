---
// AboutUs.astro
---

<section id="about" class="py-16 lg:py-20 bg-white border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-12">
    <!-- Centered Header -->
    <div class="text-center max-w-xl mx-auto space-y-2">
      <h2 class="font-gallient text-4xl sm:text-6xl text-[#000104] font-normal">About Us</h2>
      <p class="text-base text-[#5E666C]">3DO Filament (Made in EU) is prop</p>
    </div>

    <!-- 3 Columns with Centered Dotted Circle & Small Icon -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10 lg:gap-14 text-center">
      <!-- 1. EU Shipping -->
      <div class="flex flex-col items-center space-y-3">
        <!-- Custom CSS Dotted Circle with Centered Compact Icon -->
        <div class="w-16 h-16 rounded-full border-2 border-dashed border-[#3C4245] flex items-center justify-center p-3 mb-1">
          <svg class="w-7 h-7 text-[#3C4245]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 17a2 2 0 11-4 0 2 2 0 014 0zM19 17a2 2 0 11-4 0 2 2 0 014 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16V6a1 1 0 00-1-1H4a1 1 0 00-1 1v10a1 1 0 001 1h1m8-1a1 1 0 01-1 1H9m4-1V8h4l3 3v5h-2m-6 0h2"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 10l2 2 4-4"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#000104]">EU Shipping</h3>
        <p class="text-[#5E666C] leading-relaxed text-sm max-w-xs">We ship from Denmark to all across Europe.</p>
      </div>

      <!-- 2. High Quality -->
      <div class="flex flex-col items-center space-y-3">
        <div class="w-16 h-16 rounded-full border-2 border-dashed border-[#3C4245] flex items-center justify-center p-3 mb-1">
          <svg class="w-7 h-7 text-[#3C4245]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#000104]">High Quality</h3>
        <p class="text-[#5E666C] leading-relaxed text-sm max-w-xs">At 3DO we focus on quality, and do not sell any products we would not use ourself.</p>
      </div>

      <!-- 3. Safe Payment -->
      <div class="flex flex-col items-center space-y-3">
        <div class="w-16 h-16 rounded-full border-2 border-dashed border-[#3C4245] flex items-center justify-center p-3 mb-1">
          <svg class="w-7 h-7 text-[#3C4245]" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z"/>
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 14l1.5 1.5L21 13"/>
          </svg>
        </div>
        <h3 class="text-lg font-bold text-[#000104]">Safe Payment</h3>
        <p class="text-[#5E666C] leading-relaxed text-sm max-w-xs">3-D Secure v2Verified by Visa And MasterCardSecured by Nets</p>
      </div>
    </div>
  </div>
</section>


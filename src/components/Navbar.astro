---
// Navbar.astro
interface Props {
  active?: 'home' | 'about' | 'shop' | 'service' | 'news' | 'login' | 'signup';
  showCategoryBar?: boolean;
}
const { active = 'home', showCategoryBar = true } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#E8E8E8]">
  <!-- Top Primary Bar -->
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 h-20 sm:h-[92px] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group flex-shrink-0">
      <img src="/assets/icons/logo.svg" alt="Earthware" class="h-8 w-auto object-contain">
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-9 text-[18px] font-medium text-[#5E666C]">
      <a href="/" class={active === 'home' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Home</a>
      <a href="/about" class={active === 'about' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>About</a>
      <a href="/shop" class={active === 'shop' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Shop</a>
      <a href="/service" class={active === 'service' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Service</a>
      <a href="/news" class={active === 'news' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>News</a>
    </nav>

    <!-- Right Action Items (Figma cart.svg) -->
    <div class="flex items-center gap-2.5 sm:gap-6 flex-shrink-0">
      <button id="cart-btn" class="flex items-center gap-1.5 sm:gap-2 text-[15px] sm:text-[16px] font-medium text-[#5E666C] hover:text-[#000104] transition-colors btn-press p-1 sm:p-0">
        <img src="/assets/icons/cart.svg" alt="Cart" class="w-5 h-5 object-contain">
        <span class="hidden sm:inline">Cart</span>
        <span class="cart-count-badge bg-[#000104] text-white text-[11px] rounded-full w-5 h-5 flex items-center justify-center font-bold">0</span>
      </button>

      <span class="hidden sm:inline-block h-5 w-[1px] bg-neutral-300"></span>

      <a href="/login" class="hidden sm:inline-block text-[16px] font-medium text-[#230C33] hover:opacity-80">Login</a>

      <a href="/signup" class="hidden sm:inline-block bg-[#000000] text-white text-[16px] font-semibold px-8 py-3 rounded-md hover:bg-neutral-800 transition-smooth btn-press shadow-sm">
        Sign Up
      </a>

      <!-- Mobile Hamburger Button -->
      <button id="mobile-menu-btn" class="lg:hidden text-[#000104] p-2 hover:bg-neutral-100 rounded-lg transition-colors" aria-label="Toggle navigation menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Secondary Category Bar (Exact Figma/User screenshots) -->
  {showCategoryBar && (
  <div class="hidden lg:block bg-[#FAF8F5] border-t border-b border-[#EAE6DF] relative">
    <div class="max-w-[1440px] mx-auto px-6 lg:px-28 h-12 flex items-center justify-between text-[15px] text-[#4A4F54]">
      
      <!-- 1. Crockery Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent group-hover:border-black group-hover:text-black">
          <span>Crockery</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 min-w-[260px]">
          <div class="bg-[#FAF8F5] border border-[#EAE6DF] rounded-b-md shadow-xl py-3 px-5 space-y-2">
            <a href="/shop?cat=plate-sets" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Plate sets</a>
            <a href="/shop?cat=tea-cups-and-saucers" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Tea cups and Saucers</a>
            <a href="/shop?cat=2-tier-3-tier" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">2-Tier & 3-Tier</a>
            <a href="/shop?cat=dessert-set" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Dessert Set</a>
            <a href="/shop?cat=cutlery" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Cutlery</a>
            <a href="/shop?cat=cake-stand" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Cake Stand</a>
            <a href="/shop?cat=cake-lifter" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Cake Lifter</a>
            <a href="/shop?cat=mugs" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Mugs</a>
            <a href="/shop?cat=trays" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Trays</a>
            <a href="/shop?cat=glass-and-water-set" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Glass and water set</a>
            <a href="/shop?cat=jars" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Jars</a>
            <a href="/shop?cat=glasslock-containers" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">GlassLock Storage Containers</a>
          </div>
        </div>
      </div>

      <!-- 2. New Arrivals -->
      <a href="/shop?tag=new-arrivals" class="py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent hover:border-black">
        New Arrivals
      </a>

      <!-- 3. Silverware Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent group-hover:border-black group-hover:text-black">
          <span>Silverware</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 min-w-[200px]">
          <div class="bg-[#FAF8F5] border border-[#EAE6DF] rounded-b-md shadow-xl py-3 px-5 space-y-2">
            <a href="/shop?cat=silver-bowl" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Silver Bowl</a>
            <a href="/shop?cat=silver-platters" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Silver Platters</a>
            <a href="/shop?cat=chafing-dish" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Chafing Dish</a>
          </div>
        </div>
      </div>

      <!-- 4. Copperware -->
      <a href="/shop?cat=copperware" class="py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent hover:border-black">
        Copperware
      </a>

      <!-- 5. Brass Ware Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent group-hover:border-black group-hover:text-black">
          <span>Brass Ware</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute left-0 top-full pt-1 hidden group-hover:block z-50 min-w-[220px]">
          <div class="bg-[#FAF8F5] border border-[#EAE6DF] rounded-b-md shadow-xl py-3 px-5 space-y-2">
            <a href="/shop?cat=brass-ware" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Brass Ware</a>
            <a href="/shop?cat=brass-serving-thaal" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Brass Serving / Thaal</a>
            <a href="/shop?cat=brass-chafing-dish" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Brass Chafing Dish</a>
          </div>
        </div>
      </div>

      <!-- 6. Serveware -->
      <a href="/shop?cat=serveware" class="py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent hover:border-black">
        Serveware
      </a>

      <!-- 7. Casserole Dish -->
      <a href="/shop?cat=casserole-dish" class="py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent hover:border-black">
        Casserole Dish
      </a>

      <!-- 8. Home Decor Dropdown -->
      <div class="relative group">
        <button class="flex items-center gap-1.5 py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent group-hover:border-black group-hover:text-black">
          <span>Home Decor</span>
          <svg class="w-3.5 h-3.5 transition-transform duration-200 group-hover:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
          </svg>
        </button>
        <!-- Dropdown Menu -->
        <div class="absolute right-0 top-full pt-1 hidden group-hover:block z-50 min-w-[220px]">
          <div class="bg-[#FAF8F5] border border-[#EAE6DF] rounded-b-md shadow-xl py-3 px-5 space-y-2">
            <a href="/shop?cat=candle-stands" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Candle stands</a>
            <a href="/shop?cat=accessories" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Accessories</a>
            <a href="/shop?cat=planters" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Planters</a>
            <a href="/shop?cat=table-mats-placemats" class="block text-[14px] text-[#4A4F54] hover:text-black hover:font-medium transition-colors">Table mats/ placemats</a>
          </div>
        </div>
      </div>

      <!-- 9. Bathroom Set -->
      <a href="/shop?cat=bathroom-set" class="py-3 hover:text-black transition-colors font-medium border-b-2 border-transparent hover:border-black">
        Bathroom Set
      </a>

    </div>
  </div>
  )}

</header>

<!-- Mobile Menu Backdrop Overlay (Full Screen z-[998]) -->
<div id="mobile-menu-overlay" class="fixed inset-0 bg-black/60 z-[998] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

<!-- Mobile Off-Canvas Slide Drawer (Full Screen z-[999]) -->
<aside id="mobile-menu" class="fixed top-0 right-0 h-full w-[85%] max-w-[340px] bg-white z-[999] shadow-2xl transform translate-x-full transition-transform duration-300 flex flex-col justify-between lg:hidden overflow-hidden">
  
  <!-- Drawer Header -->
  <div class="p-5 border-b border-neutral-100 flex items-center justify-between bg-white flex-shrink-0">
    <a href="/" class="flex items-center gap-2">
      <img src="/assets/icons/logo.svg" alt="Earthware" class="h-7 w-auto object-contain">
    </a>
    <button id="close-mobile-menu-btn" class="p-2 text-neutral-500 hover:text-black rounded-lg transition-colors" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <!-- Drawer Navigation Content -->
  <div class="p-5 space-y-5 overflow-y-auto flex-1 bg-white">
    <!-- Main Nav Links (ListTile Style with Horizontal Chevron) -->
    <nav class="space-y-1 text-sm font-semibold">
      <a href="/" class={active === 'home' ? "group flex items-center justify-between py-2.5 px-3 rounded-lg bg-neutral-100 text-[#000104] font-bold" : "group flex items-center justify-between py-2.5 px-3 rounded-lg text-neutral-700 hover:text-black hover:bg-neutral-50 transition-colors"}>
        <span>Home</span>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/about" class={active === 'about' ? "group flex items-center justify-between py-2.5 px-3 rounded-lg bg-neutral-100 text-[#000104] font-bold" : "group flex items-center justify-between py-2.5 px-3 rounded-lg text-neutral-700 hover:text-black hover:bg-neutral-50 transition-colors"}>
        <span>About</span>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/shop" class={active === 'shop' ? "group flex items-center justify-between py-2.5 px-3 rounded-lg bg-neutral-100 text-[#000104] font-bold" : "group flex items-center justify-between py-2.5 px-3 rounded-lg text-neutral-700 hover:text-black hover:bg-neutral-50 transition-colors"}>
        <span>Shop</span>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/service" class={active === 'service' ? "group flex items-center justify-between py-2.5 px-3 rounded-lg bg-neutral-100 text-[#000104] font-bold" : "group flex items-center justify-between py-2.5 px-3 rounded-lg text-neutral-700 hover:text-black hover:bg-neutral-50 transition-colors"}>
        <span>Service</span>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
      <a href="/news" class={active === 'news' ? "group flex items-center justify-between py-2.5 px-3 rounded-lg bg-neutral-100 text-[#000104] font-bold" : "group flex items-center justify-between py-2.5 px-3 rounded-lg text-neutral-700 hover:text-black hover:bg-neutral-50 transition-colors"}>
        <span>News</span>
        <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
      </a>
    </nav>


    <!-- Categories Accordion Section (ListTile Style) -->
    <div class="pt-4 border-t border-neutral-100">
      <p class="text-[11px] font-bold text-neutral-400 uppercase tracking-wider mb-2 px-1">Explore Categories</p>
      <div class="space-y-1 text-sm font-medium text-neutral-700">
        
        <!-- Crockery (Expandable ListTile with horizontal arrow rotating to down) -->
        <details class="group">
          <summary class="cursor-pointer list-none flex justify-between items-center py-2 px-2.5 rounded-lg hover:bg-neutral-50 font-semibold text-[#000104] transition-colors">
            <span>Crockery</span>
            <svg class="w-4 h-4 text-neutral-400 group-open:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </summary>
          <div class="pl-4 pr-1 pt-1 pb-2 space-y-1 text-xs text-[#5E666C] border-l-2 border-neutral-100 ml-3.5 my-1">
            <a href="/shop?cat=plate-sets" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Plate sets</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=tea-cups-and-saucers" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Tea cups and Saucers</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=2-tier-3-tier" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>2-Tier & 3-Tier</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=dessert-set" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Dessert Set</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=cutlery" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Cutlery</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=cake-stand" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Cake Stand</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=cake-lifter" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Cake Lifter</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=mugs" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Mugs</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=trays" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Trays</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=glass-and-water-set" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Glass and water set</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=jars" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Jars</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=glasslock-containers" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>GlassLock Storage Containers</span><span class="text-neutral-300">›</span></a>
          </div>
        </details>

        <!-- New Arrivals (Direct ListTile) -->
        <a href="/shop?tag=new-arrivals" class="group flex items-center justify-between py-2 px-2.5 rounded-lg hover:bg-neutral-50 text-neutral-800 hover:text-black transition-colors">
          <span>New Arrivals</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>

        <!-- Silverware -->
        <details class="group">
          <summary class="cursor-pointer list-none flex justify-between items-center py-2 px-2.5 rounded-lg hover:bg-neutral-50 font-semibold text-[#000104] transition-colors">
            <span>Silverware</span>
            <svg class="w-4 h-4 text-neutral-400 group-open:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </summary>
          <div class="pl-4 pr-1 pt-1 pb-2 space-y-1 text-xs text-[#5E666C] border-l-2 border-neutral-100 ml-3.5 my-1">
            <a href="/shop?cat=silver-bowl" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Silver Bowl</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=silver-platters" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Silver Platters</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=chafing-dish" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Chafing Dish</span><span class="text-neutral-300">›</span></a>
          </div>
        </details>

        <!-- Copperware -->
        <a href="/shop?cat=copperware" class="group flex items-center justify-between py-2 px-2.5 rounded-lg hover:bg-neutral-50 text-neutral-800 hover:text-black transition-colors">
          <span>Copperware</span>
          <svg class="w-4 h-4 text-neutral-400 group-hover:text-black group-hover:translate-x-0.5 transition-all" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
        </a>

        <!-- Brass Ware -->
        <details class="group">
          <summary class="cursor-pointer list-none flex justify-between items-center py-2 px-2.5 rounded-lg hover:bg-neutral-50 font-semibold text-[#000104] transition-colors">
            <span>Brass Ware</span>
            <svg class="w-4 h-4 text-neutral-400 group-open:rotate-90 transition-transform duration-200" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </summary>
          <div class="pl-4 pr-1 pt-1 pb-2 space-y-1 text-xs text-[#5E666C] border-l-2 border-neutral-100 ml-3.5 my-1">
            <a href="/shop?cat=brass-ware" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Brass Ware</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=brass-serving-thaal" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Brass Serving / Thaal</span><span class="text-neutral-300">›</span></a>
            <a href="/shop?cat=brass-chafing-dish" class="flex items-center justify-between py-1.5 px-2 rounded hover:bg-neutral-50 hover:text-black transition-colors"><span>Brass Chafing Dish</span><span class="text-neutral-300">›</span></a>
          </div>
        </details>

        <!-- Serveware -->

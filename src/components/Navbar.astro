---
// Navbar.astro
interface Props {
  active?: 'home' | 'about' | 'shop' | 'service' | 'news';
}
const { active = 'home' } = Astro.props;
---

<header class="sticky top-0 z-40 bg-white/95 backdrop-blur-md border-b border-[#E8E8E8]">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 h-20 sm:h-[92px] flex items-center justify-between">
    
    <!-- Logo -->
    <a href="/" class="flex items-center gap-2 group flex-shrink-0">
      <img src="/assets/icons/logo.svg" alt="Earthware" class="h-8 w-auto object-contain">
    </a>

    <!-- Desktop Nav Links -->
    <nav class="hidden lg:flex items-center gap-9 text-[18px] font-medium text-[#5E666C]">
      <a href="/" class={active === 'home' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Home</a>
      <a href="/about" class={active === 'about' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>About</a>
      <a href="/shop" class={active === 'shop' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Shop</a>
      <a href="/#categories" class={active === 'service' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>Service</a>
      <a href="/#blog" class={active === 'news' ? "text-[#000104] font-semibold" : "hover:text-[#000104] transition-colors"}>News</a>
    </nav>

    <!-- Right Action Items (Figma cart.svg) -->
    <div class="flex items-center gap-4 sm:gap-6 flex-shrink-0">
      <button id="cart-btn" class="flex items-center gap-2 text-[16px] font-medium text-[#5E666C] hover:text-[#000104] transition-colors btn-press">
        <img src="/assets/icons/cart.svg" alt="Cart" class="w-5 h-5 object-contain">
        <span class="hidden sm:inline">Cart</span>
        <span class="cart-count-badge bg-[#000104] text-white text-xs rounded-full w-5 h-5 flex items-center justify-center font-bold">0</span>
      </button>

      <span class="hidden sm:inline-block h-5 w-[1px] bg-neutral-300"></span>

      <a href="#login" class="hidden sm:inline-block text-[16px] font-medium text-[#230C33] hover:opacity-80">Login</a>

      <a href="#signup" class="bg-[#000000] text-white text-[16px] font-semibold px-8 py-3 rounded-md hover:bg-neutral-800 transition-smooth btn-press shadow-sm">
        Sign Up
      </a>

      <button id="mobile-menu-btn" class="lg:hidden text-[#000104] p-2" aria-label="Toggle navigation menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white border-b border-neutral-200 px-6 py-4 space-y-3">
    <a href="/" class={active === 'home' ? "block font-semibold text-[#000104]" : "block text-[#5E666C] hover:text-[#000104]"}>Home</a>
    <a href="/about" class={active === 'about' ? "block font-semibold text-[#000104]" : "block text-[#5E666C] hover:text-[#000104]"}>About</a>
    <a href="/shop" class={active === 'shop' ? "block font-semibold text-[#000104]" : "block text-[#5E666C] hover:text-[#000104]"}>Shop</a>
    <a href="/#categories" class="block text-[#5E666C] hover:text-[#000104]">Service</a>
    <a href="/#blog" class="block text-[#5E666C] hover:text-[#000104]">News</a>
  </div>
</header>


---
// Testimonials.astro
import { testimonialsData } from '../data/mockData.js';

const prev = testimonialsData[0];
const current = testimonialsData[1];
const next = testimonialsData[2];
---

<section class="py-16 lg:py-24 bg-white overflow-hidden border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-28 space-y-8 sm:space-y-12">
    <div class="text-center">
      <h2 class="font-gallient text-4xl sm:text-6xl text-[#000104] font-normal">What our client say</h2>
    </div>

    <!-- Testimonials Wrapper -->
    <div class="max-w-7xl mx-auto">
      
      <!-- Cards Container -->
      <div id="testimonials-container" class="relative flex items-center justify-center gap-4 lg:gap-6 py-4 sm:py-8">
        
        <!-- 1. Left Tilted Card (Desktop/Tablet, -10 deg, Peach #FFF0EB) -->
        <div 
          id="test-prev-card"
          class="hidden md:flex w-[420px] lg:w-[480px] min-h-[210px] sm:min-h-[230px] bg-[#FFF0EB] rounded-[24px] p-6 sm:p-7 shadow-sm transform -rotate-[8deg] lg:-rotate-[10deg] opacity-85 hover:opacity-100 hover:rotate-0 transition-all duration-300 relative flex-shrink-0 cursor-pointer items-center"
        >
          <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
          <div class="flex gap-5 items-center w-full">
            <div class="flex flex-col items-center justify-center gap-1.5 pr-5 border-r border-dashed border-[#000104]/30 flex-shrink-0 w-28 text-center">
              <img src={prev.avatar.startsWith('/') ? prev.avatar : `/${prev.avatar}`} alt={prev.name} class="w-14 h-14 rounded-full object-cover shadow-sm">
              <div>
                <h5 class="font-bold text-sm text-[#000104] leading-tight mt-1">{prev.name}</h5>
                <span class="text-[11px] text-[#5E666C]">{prev.location}</span>
              </div>
            </div>
            <p class="text-xs sm:text-[13px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
              {prev.quote}
            </p>
          </div>
        </div>

        <!-- Desktop Left Navigation Arrow (←) -->
        <button 
          id="test-prev-btn" 
          class="hidden md:flex w-11 h-11 rounded-full border border-neutral-300 bg-white items-center justify-center hover:bg-neutral-50 transition-all flex-shrink-0 z-20 btn-press shadow-sm hover:scale-105" 
          aria-label="Previous Testimonial"
        >
          <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
        </button>

        <!-- 2. Center Card (Spacious full width on mobile, Olive #F0F2E5) -->
        <div 
          class="w-full max-w-[480px] lg:max-w-[540px] min-h-[220px] sm:min-h-[240px] bg-[#F0F2E5] rounded-[24px] p-6 sm:p-7 shadow-md relative z-10 card-hover flex-shrink-0 flex items-center"
        >
          <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 sm:w-6 sm:h-6 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
          <div class="flex gap-5 sm:gap-6 items-center w-full">
            <div class="flex flex-col items-center justify-center gap-1.5 pr-5 sm:pr-6 border-r border-dashed border-[#000104]/30 flex-shrink-0 text-center w-28 sm:w-32">
              <img 
                src={current.avatar.startsWith('/') ? current.avatar : `/${current.avatar}`} 
                alt={current.name} 
                class="w-14 h-14 sm:w-16 sm:h-16 rounded-full object-cover shadow-sm border-2 border-white"
              >
              <div>
                <h4 class="font-bold text-[#000104] text-sm sm:text-base leading-tight mt-1">{current.name}</h4>
                <p class="text-[11px] sm:text-xs text-[#5E666C] mt-0.5">{current.location}</p>
              </div>
            </div>

            <p class="text-xs sm:text-[13px] lg:text-[14px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
              {current.quote}
            </p>
          </div>
        </div>

        <!-- Desktop Right Navigation Arrow (→) -->
        <button 
          id="test-next-btn" 
          class="hidden md:flex w-11 h-11 rounded-full border border-neutral-300 bg-white items-center justify-center hover:bg-neutral-50 transition-all flex-shrink-0 z-20 btn-press shadow-sm hover:scale-105" 
          aria-label="Next Testimonial"
        >
          <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>

        <!-- 3. Right Tilted Card (Desktop/Tablet, +10 deg, Soft Blue #C3E4EE) -->
        <div 
          id="test-next-card"
          class="hidden md:flex w-[420px] lg:w-[480px] min-h-[210px] sm:min-h-[230px] bg-[#C3E4EE] rounded-[24px] p-6 sm:p-7 shadow-sm transform rotate-[8deg] lg:rotate-[10deg] opacity-85 hover:opacity-100 hover:rotate-0 transition-all duration-300 relative flex-shrink-0 cursor-pointer items-center"
        >
          <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
          <div class="flex gap-5 items-center w-full">
            <div class="flex flex-col items-center justify-center gap-1.5 pr-5 border-r border-dashed border-[#000104]/30 flex-shrink-0 w-28 text-center">
              <img src={next.avatar.startsWith('/') ? next.avatar : `/${next.avatar}`} alt={next.name} class="w-14 h-14 rounded-full object-cover shadow-sm">
              <div>
                <h5 class="font-bold text-sm text-[#000104] leading-tight mt-1">{next.name}</h5>
                <span class="text-[11px] text-[#5E666C]">{next.location}</span>
              </div>
            </div>
            <p class="text-xs sm:text-[13px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
              {next.quote}
            </p>
          </div>
        </div>

      </div>

      <!-- Mobile Navigation Arrows (Centered Below Card on Mobile to give Card Maximum Space) -->
      <div class="flex md:hidden items-center justify-center gap-5 pt-2">
        <button 
          id="test-prev-btn-mob" 
          class="w-11 h-11 rounded-full border border-neutral-300 bg-white flex items-center justify-center hover:bg-neutral-50 transition-all btn-press shadow-sm hover:scale-105 active:scale-95" 
          aria-label="Previous Testimonial"
        >
          <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
          </svg>
        </button>
        <button 
          id="test-next-btn-mob" 
          class="w-11 h-11 rounded-full border border-neutral-300 bg-white flex items-center justify-center hover:bg-neutral-50 transition-all btn-press shadow-sm hover:scale-105 active:scale-95" 
          aria-label="Next Testimonial"
        >
          <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </button>
      </div>

    </div>
  </div>
</section>

<script>
  import { testimonialsData } from '../data/mockData.js';

  let activeIndex = 1; // Default to index 1 (Jenny Wilson)

  function updateTestimonials() {
    const container = document.getElementById('testimonials-container');
    if (!container) return;

    const total = testimonialsData.length;
    const current = testimonialsData[activeIndex];
    const prev = testimonialsData[(activeIndex - 1 + total) % total];
    const next = testimonialsData[(activeIndex + 1) % total];

    const prevAvatar = prev.avatar.startsWith('/') ? prev.avatar : `/${prev.avatar}`;
    const currentAvatar = current.avatar.startsWith('/') ? current.avatar : `/${current.avatar}`;
    const nextAvatar = next.avatar.startsWith('/') ? next.avatar : `/${next.avatar}`;

    container.innerHTML = `
      <!-- 1. Left Tilted Card (Desktop, -10 deg, Peach #FFF0EB) -->
      <div 
        id="test-prev-card"
        class="hidden md:flex w-[420px] lg:w-[480px] min-h-[210px] sm:min-h-[230px] bg-[#FFF0EB] rounded-[24px] p-6 sm:p-7 shadow-sm transform -rotate-[8deg] lg:-rotate-[10deg] opacity-85 hover:opacity-100 hover:rotate-0 transition-all duration-300 relative flex-shrink-0 cursor-pointer items-center"
      >
        <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
        <div class="flex gap-5 items-center w-full">
          <div class="flex flex-col items-center justify-center gap-1.5 pr-5 border-r border-dashed border-[#000104]/30 flex-shrink-0 w-28 text-center">
            <img src="${prevAvatar}" alt="${prev.name}" class="w-14 h-14 rounded-full object-cover shadow-sm">
            <div>
              <h5 class="font-bold text-sm text-[#000104] leading-tight mt-1">${prev.name}</h5>
              <span class="text-[11px] text-[#5E666C]">${prev.location}</span>
            </div>
          </div>
          <p class="text-xs sm:text-[13px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
            ${prev.quote}
          </p>
        </div>
      </div>

      <!-- Desktop Left Navigation Arrow (←) -->
      <button 
        id="test-prev-btn" 
        class="hidden md:flex w-11 h-11 rounded-full border border-neutral-300 bg-white items-center justify-center hover:bg-neutral-50 transition-all flex-shrink-0 z-20 btn-press shadow-sm hover:scale-105 active:scale-95" 
        aria-label="Previous Testimonial"
      >
        <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
      </button>

      <!-- 2. Center Card (Spacious full width on mobile, Olive #F0F2E5) -->
      <div 
        id="test-center-card"
        class="w-full max-w-[480px] lg:max-w-[540px] min-h-[220px] sm:min-h-[240px] bg-[#F0F2E5] rounded-[24px] p-6 sm:p-7 shadow-md relative z-10 card-hover flex-shrink-0 flex items-center transition-all duration-300"
      >
        <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 sm:w-6 sm:h-6 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
        <div class="flex gap-5 sm:gap-6 items-center w-full">
          <div class="flex flex-col items-center justify-center gap-1.5 pr-5 sm:pr-6 border-r border-dashed border-[#000104]/30 flex-shrink-0 text-center w-28 sm:w-32">
            <img 
              src="${currentAvatar}" 
              alt="${current.name}" 
              class="w-14 h-14 sm:w-16 sm:h-16 rounded-full object-cover shadow-sm border-2 border-white"
            >
            <div>
              <h4 class="font-bold text-[#000104] text-sm sm:text-base leading-tight mt-1">${current.name}</h4>
              <p class="text-[11px] sm:text-xs text-[#5E666C] mt-0.5">${current.location}</p>
            </div>
          </div>

          <p class="text-xs sm:text-[13px] lg:text-[14px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
            ${current.quote}
          </p>
        </div>
      </div>

      <!-- Desktop Right Navigation Arrow (→) -->
      <button 
        id="test-next-btn" 
        class="hidden md:flex w-11 h-11 rounded-full border border-neutral-300 bg-white items-center justify-center hover:bg-neutral-50 transition-all flex-shrink-0 z-20 btn-press shadow-sm hover:scale-105 active:scale-95" 
        aria-label="Next Testimonial"
      >
        <svg class="w-4 h-4 text-neutral-800" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </button>

      <!-- 3. Right Tilted Card (Desktop, +10 deg, Soft Blue #C3E4EE) -->
      <div 
        id="test-next-card"
        class="hidden md:flex w-[420px] lg:w-[480px] min-h-[210px] sm:min-h-[230px] bg-[#C3E4EE] rounded-[24px] p-6 sm:p-7 shadow-sm transform rotate-[8deg] lg:rotate-[10deg] opacity-85 hover:opacity-100 hover:rotate-0 transition-all duration-300 relative flex-shrink-0 cursor-pointer items-center"
      >
        <img src="/assets/icons/quote-icon.svg" alt="" class="w-5 h-5 absolute top-4 sm:top-5 left-5 sm:left-6 opacity-90">
        <div class="flex gap-5 items-center w-full">
          <div class="flex flex-col items-center justify-center gap-1.5 pr-5 border-r border-dashed border-[#000104]/30 flex-shrink-0 w-28 text-center">
            <img src="${nextAvatar}" alt="${next.name}" class="w-14 h-14 rounded-full object-cover shadow-sm">
            <div>
              <h5 class="font-bold text-sm text-[#000104] leading-tight mt-1">${next.name}</h5>
              <span class="text-[11px] text-[#5E666C]">${next.location}</span>
            </div>
          </div>
          <p class="text-xs sm:text-[13px] text-[#5E666C] leading-relaxed line-clamp-4 flex-1">
            ${next.quote}
          </p>
        </div>
      </div>
    `;

    // Rebind newly created desktop buttons and side cards
    bindDesktopTriggers();
  }

  function goPrev() {
    activeIndex = (activeIndex - 1 + testimonialsData.length) % testimonialsData.length;
    updateTestimonials();
  }

  function goNext() {
    activeIndex = (activeIndex + 1) % testimonialsData.length;
    updateTestimonials();
  }

  function bindDesktopTriggers() {
    const prevBtn = document.getElementById('test-prev-btn');
    const nextBtn = document.getElementById('test-next-btn');
    const prevCard = document.getElementById('test-prev-card');
    const nextCard = document.getElementById('test-next-card');

    if (prevBtn) prevBtn.onclick = goPrev;
    if (nextBtn) nextBtn.onclick = goNext;
    if (prevCard) prevCard.onclick = goPrev;
    if (nextCard) nextCard.onclick = goNext;
  }

  // Bind Mobile Previous / Next Buttons
  const prevBtnMob = document.getElementById('test-prev-btn-mob');
  const nextBtnMob = document.getElementById('test-next-btn-mob');

  if (prevBtnMob) prevBtnMob.onclick = goPrev;
  if (nextBtnMob) nextBtnMob.onclick = goNext;

  // Initial binding for desktop static elements
  bindDesktopTriggers();
</script>

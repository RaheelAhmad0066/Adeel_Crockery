---
// Products.astro - Fully Dynamic from Supabase Cloud
---

<section id="products" class="bg-earth-peach py-16 lg:py-24 overflow-hidden border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <h2 class="font-gallient text-3xl sm:text-5xl lg:text-[54px] text-[#000104] font-normal leading-[1.12]">
        We personalize the most beautiful and sustainable products for your brand to shine in real life.
      </h2>
      <div class="pt-2">
        <a href="/shop" class="inline-block bg-[#000104] text-white text-sm font-semibold px-8 py-3.5 rounded-md hover:bg-neutral-800 transition-smooth shadow-md btn-press">
          View all products
        </a>
      </div>
    </div>

    <!-- Products 4-Grid Container: Dynamic from Supabase -->
    <div id="products-grid-container" class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 min-h-[250px]">
      <!-- Dynamically populated from Supabase getHomeFeaturedProducts -->
    </div>
  </div>
</section>

<script>
  import { getHomeFeaturedProducts } from '../services/dbService.js';
  getHomeFeaturedProducts().then((liveFeat: any[]) => {
    if (liveFeat && liveFeat.length > 0) {
      const container = document.getElementById('products-grid-container');
      if (container) {
        container.innerHTML = '';
        liveFeat.slice(0, 4).forEach((prod: any) => {
          let imgSrc = prod.image || '';
          if (imgSrc && !imgSrc.startsWith('http://') && !imgSrc.startsWith('https://') && !imgSrc.startsWith('data:') && !imgSrc.startsWith('/')) {
            imgSrc = `/${imgSrc}`;
          }
          const card = document.createElement('div');
          card.className = 'flex flex-col justify-between group bg-white/60 p-3 sm:p-4 rounded-xl border border-neutral-100 hover:bg-white hover:shadow-md transition-all';
          card.innerHTML = `
            <a href="/product?id=${prod.id}" class="w-full aspect-square bg-white rounded-lg p-3 sm:p-5 flex items-center justify-center shadow-sm card-hover border border-neutral-100 block group-hover:shadow-md transition-shadow">
              <img src="${imgSrc}" alt="${prod.name}" onerror="this.onerror=null; this.src='/assets/images/prod-1.png';" class="max-h-28 sm:max-h-36 max-w-full object-contain group-hover:scale-105 transition-transform duration-300" />
            </a>
            <div class="pt-3 sm:pt-4 space-y-1 sm:space-y-1.5 flex flex-col items-start w-full">
              <a href="/product?id=${prod.id}" class="text-xs sm:text-[15px] text-[#3C4245] font-normal truncate hover:text-[#000104] transition-colors block max-w-full">
                ${prod.name}
              </a>
              <div class="text-base sm:text-xl font-bold text-[#000104]">
                PKR ${Number(prod.price || 0).toLocaleString()}
              </div>
              <button class="add-to-cart-btn mt-1.5 inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 border border-neutral-400 rounded text-xs font-semibold text-[#000104] hover:bg-[#000104] hover:text-white transition-smooth btn-press w-full sm:w-auto justify-center" data-id="${prod.id}" data-name="${prod.name}" data-price="${prod.price}" data-image="${imgSrc}">
                <img src="/assets/icons/cart.svg" alt="" class="w-3.5 h-3.5 object-contain" />
                <span>Cart</span>
              </button>
            </div>
          `;
          container.appendChild(card);
        });

        // Re-attach cart listeners
        container.querySelectorAll('.add-to-cart-btn').forEach((btn: any) => {
          btn.addEventListener('click', (e: any) => {
            e.stopPropagation();
            const id = btn.getAttribute('data-id');
            const name = btn.getAttribute('data-name');
            const price = parseFloat(btn.getAttribute('data-price') || '0');
            const image = btn.getAttribute('data-image');
            if ((window as any).addToCart) {
              (window as any).addToCart({ id, name, price, image, quantity: 1 });
            }
          });
        });
      }
    }
  }).catch(() => {});
</script>


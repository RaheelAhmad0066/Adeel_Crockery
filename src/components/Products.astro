---
// Products.astro - Exact Figma layout matching Image 2
import { productsData } from '../data/mockData.js';
---

<section id="products" class="bg-earth-peach py-16 lg:py-24 overflow-hidden border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <h2 class="font-gallient text-3xl sm:text-5xl lg:text-[54px] text-[#000104] font-normal leading-[1.12]">
        We personalize the most beautiful and sustainable products for your brand to shine in real life.
      </h2>
      <div class="pt-2">
        <a href="/shop" class="inline-block bg-[#000104] text-white text-sm font-semibold px-8 py-3.5 rounded-md hover:bg-neutral-800 transition-smooth shadow-md btn-press">
          View all products
        </a>
      </div>
    </div>

    <!-- Products Container matching Image 2 -->
    <div id="products-grid-container" class="flex gap-6 overflow-x-auto pb-4 hide-scrollbar">
      {productsData.map((prod) => {
        const imgSrc = prod.image.startsWith('/') ? prod.image : `/${prod.image}`;
        return (
          <div class="w-[230px] sm:w-[240px] flex-shrink-0 flex flex-col justify-between group">
            <!-- Aspect Square White Box -->
            <a 
              href={`/product?id=${prod.id}`}
              class="w-full aspect-square bg-white rounded-lg p-5 flex items-center justify-center shadow-sm card-hover border border-neutral-100 block group-hover:shadow-md transition-shadow"
            >
              <img 
                src={imgSrc} 
                alt={prod.name} 
                class="max-h-36 max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
              />
            </a>

            <!-- Text & Rectangular Cart Button -->
            <div class="pt-4 space-y-1.5 flex flex-col items-start">
              <a 
                href={`/product?id=${prod.id}`}
                class="text-[15px] text-[#3C4245] font-normal truncate hover:text-[#000104] transition-colors block max-w-full"
              >
                {prod.name}
              </a>
              <div class="text-xl font-bold text-[#000104]">
                {prod.currency || '€'}{prod.price}
              </div>
              <button 
                class="add-to-cart-btn mt-2 inline-flex items-center gap-2 px-4 py-1.5 border border-neutral-400 rounded text-xs font-semibold text-[#000104] hover:bg-[#000104] hover:text-white transition-smooth btn-press"
                data-id={prod.id}
                data-name={prod.name}
                data-price={prod.price}
                data-image={imgSrc}
                onclick="event.stopPropagation();"
              >
                <img src="/assets/icons/cart.svg" alt="" class="w-3.5 h-3.5 object-contain">
                <span>Cart</span>
              </button>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

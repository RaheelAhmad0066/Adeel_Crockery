---
// Products.astro
import { productsData } from '../data/mockData.js';
---

<section id="products" class="bg-earth-peach py-16 lg:py-24 overflow-hidden border-b border-neutral-200/60">
  <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
    <div class="text-center max-w-4xl mx-auto space-y-6">
      <h2 class="font-gallient text-3xl sm:text-5xl lg:text-[54px] text-[#000104] font-normal leading-[1.12]">
        We personalize the most beautiful and sustainable products for your brand to shine in real life.
      </h2>
      <div class="pt-2">
        <a href="#products" class="inline-block bg-[#000104] text-white text-sm font-semibold px-8 py-3.5 rounded-md hover:bg-neutral-800 transition-smooth shadow-md btn-press">
          View all products
        </a>
      </div>
    </div>

    <!-- Products Container -->
    <div id="products-grid-container" class="flex gap-5 overflow-x-auto pb-4 hide-scrollbar">
      {productsData.map((prod) => (
        <div class="flex-shrink-0 w-[200px] sm:w-[220px] bg-white rounded-xl p-4 border border-[#E8E8E8] shadow-sm hover:shadow-md transition-smooth cursor-pointer group flex flex-col justify-between">
          <div class="h-40 w-full flex items-center justify-center p-2 mb-3 overflow-hidden bg-[#FAF8F5] rounded-lg">
            <img 
              src={prod.image.startsWith('/') ? prod.image : `/${prod.image}`} 
              alt={prod.name} 
              class="max-h-full max-w-full object-contain group-hover:scale-105 transition-transform duration-300"
            />
          </div>

          <div class="space-y-2">
            <h4 class="font-medium text-sm text-[#000104] line-clamp-1">{prod.name}</h4>
            <div class="flex items-center justify-between">
              <span class="text-xs text-[#5E666C]">{prod.currency || '€'}{prod.price}</span>
              <button 
                data-add-prod={prod.id} 
                class="w-7 h-7 rounded-full bg-[#000104] text-white flex items-center justify-center hover:bg-neutral-700 transition-colors btn-press shadow-sm"
                aria-label={`Add ${prod.name} to cart`}
              >
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                </svg>
              </button>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>


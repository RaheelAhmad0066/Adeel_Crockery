---
// src/pages/signup.astro - Exactly matching Figma SignUp screen
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
---

<Layout title="Sign Up — Earthware">
  <Navbar active="signup" showCategoryBar={false} />

  <main class="bg-white min-h-screen relative overflow-hidden flex flex-col justify-between">

    <!-- ================= 1. HERO BANNER (Figma Create Account Texture) ================= -->
    <section class="relative overflow-hidden py-14 sm:py-20 bg-[#F4EBE1] border-b border-neutral-200/50">
      <img 
        src="/assets/images/Hero Section.svg" 
        alt="" 
        class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-60 mix-blend-multiply"
      />

      <div class="max-w-[1440px] mx-auto px-6 lg:px-20 text-center relative z-10 space-y-3">
        <div class="inline-flex items-center gap-1.5 text-xs sm:text-sm text-[#000104] font-medium tracking-wide">
          <span>Create</span>
          <span class="bg-[#000104] text-white px-2.5 py-0.5 rounded text-xs font-semibold">Account</span>
        </div>

        <h1 class="font-gallient text-4xl sm:text-6xl md:text-[68px] font-normal text-[#000104] tracking-tight">
          Sign Up
        </h1>
      </div>
    </section>

    <!-- ================= 2. SIGNUP FORM SECTION ================= -->
    <section class="relative py-16 sm:py-24 px-4 flex-1 flex items-center justify-center">
      
      <!-- Decorative Background Tag (matching Figma bottom left corner) -->
      <div class="absolute bottom-4 left-0 sm:left-4 w-44 sm:w-60 opacity-60 sm:opacity-85 pointer-events-none select-none z-0">
        <img 
          src="/assets/icons/tag-icon.svg" 
          alt="" 
          class="w-full h-auto"
        />
      </div>

      <!-- Centered Card -->
      <div class="relative z-10 w-full max-w-[460px] bg-[#F1EFE6] rounded-2xl p-8 sm:p-11 shadow-sm border border-neutral-200/40">
        
        <!-- Form Header -->
        <h2 class="font-gallient text-3xl sm:text-4xl text-[#000104] font-normal mb-8">
          Signup
        </h2>

        <form id="signup-form" class="space-y-4" onsubmit="event.preventDefault();">
          
          <!-- Email Field -->
          <div class="space-y-1.5">
            <label for="email" class="block text-xs font-medium text-[#4A4F54]">
              Email
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-neutral-400 pointer-events-none flex items-center">
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
              </span>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required 
                placeholder="Enter your email" 
                class="w-full bg-transparent border border-[#CCD0CA] rounded-md pl-10 pr-4 py-2.5 text-xs text-[#000104] placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
              />
            </div>
          </div>

          <!-- Password Field 1 -->
          <div class="space-y-1.5">
            <label for="password" class="block text-xs font-medium text-[#4A4F54]">
              Password
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-neutral-400 pointer-events-none flex items-center">
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input 
                type="password" 
                id="password" 
                name="password" 
                required 
                placeholder="••••••••" 
                class="w-full bg-transparent border border-[#CCD0CA] rounded-md pl-10 pr-10 py-2.5 text-xs text-[#000104] placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
              />
              <button 
                type="button" 
                id="toggle-password" 
                class="absolute right-3 text-neutral-400 hover:text-neutral-700 transition-colors p-1"
                aria-label="Toggle password visibility"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm Password Field 2 -->
          <div class="space-y-1.5">
            <label for="confirm-password" class="block text-xs font-medium text-[#4A4F54]">
              Password
            </label>
            <div class="relative flex items-center">
              <span class="absolute left-3.5 text-neutral-400 pointer-events-none flex items-center">
                <svg class="w-4 h-4 text-neutral-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
              </span>
              <input 
                type="password" 
                id="confirm-password" 
                name="confirm-password" 
                required 
                placeholder="Enter password" 
                class="w-full bg-transparent border border-[#CCD0CA] rounded-md pl-10 pr-10 py-2.5 text-xs text-[#000104] placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black transition-colors"
              />
              <button 
                type="button" 
                id="toggle-confirm-password" 
                class="absolute right-3 text-neutral-400 hover:text-neutral-700 transition-colors p-1"
                aria-label="Toggle password visibility"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Terms & Conditions checkbox matching Figma -->
          <div class="pt-1">
            <label class="flex items-start gap-2 cursor-pointer text-[11px] text-[#5E666C] leading-snug">
              <input 
                type="checkbox" 
                required 
                class="w-3.5 h-3.5 mt-0.5 rounded border-neutral-300 text-black focus:ring-black accent-black cursor-pointer"
              />
              <span>
                I agree to platform's <a href="#" class="text-[#E04F36] hover:underline">Terms of Service</a> and <a href="#" class="text-[#E04F36] hover:underline">Privacy Policy</a>
              </span>
            </label>
          </div>

          <!-- Submit Button -->
          <div class="pt-3">
            <button 
              type="submit" 
              class="w-full bg-[#000104] text-white py-3 rounded-md text-xs font-semibold tracking-wide hover:bg-neutral-800 transition-colors btn-press shadow-sm"
            >
              Sign Up
            </button>
          </div>

          <!-- Footer Switch to Login -->
          <div class="text-center pt-2 text-xs text-[#5E666C]">
            <span>Already have an account? </span>
            <a href="/login" class="font-semibold text-[#000104] hover:underline underline-offset-2">
              Login
            </a>
          </div>

        </form>

      </div>
    </section>

  </main>

  <Footer />
  <CartDrawer />
</Layout>

<script>
  // Simple password toggle logic
  const toggleBtn1 = document.getElementById('toggle-password');
  const passwordInput1 = document.getElementById('password') as HTMLInputElement | null;
  if (toggleBtn1 && passwordInput1) {
    toggleBtn1.addEventListener('click', () => {
      const isPassword = passwordInput1.type === 'password';
      passwordInput1.type = isPassword ? 'text' : 'password';
    });
  }

  const toggleBtn2 = document.getElementById('toggle-confirm-password');
  const passwordInput2 = document.getElementById('confirm-password') as HTMLInputElement | null;
  if (toggleBtn2 && passwordInput2) {
    toggleBtn2.addEventListener('click', () => {
      const isPassword = passwordInput2.type === 'password';
      passwordInput2.type = isPassword ? 'text' : 'password';
    });
  }
</script>


---
// src/pages/product.astro - Product Detail Page matching Figma
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import { shopProductsData, getProductById } from '../data/mockData.js';

// Resolve product from URL query param if present, fallback to sp-1
const urlId = Astro.url.searchParams.get('id');
const initialProduct = getProductById(urlId || 'sp-1');

// Similar Products (4 items from screenshot)
const similarProducts = [
  { id: 'sp-1', name: 'Ceramic Plant Pot', price: 100, image: '/assets/images/shop-1.svg', rating: 5 },
  { id: 'sp-2', name: 'Terracotta Mug', price: 100, image: '/assets/images/shop-2.svg', rating: 5 },
  { id: 'sp-4', name: 'Ceramic Glass', price: 100, image: '/assets/images/shop-4.svg', rating: 5 },
  { id: 'sp-5', name: 'Stoneware Bowl', price: 100, image: '/assets/images/shop-5.svg', rating: 5 },
];
---

<Layout title={`${initialProduct.name} — Earthware Ceramic Pot Website`}>
  <Navbar active="shop" />

  <main class="bg-white">

    <!-- ================= 1. PRODUCT HERO BANNER ================= -->
    <section class="relative overflow-hidden py-14 sm:py-20 bg-[#F9ECE7] border-b border-neutral-200/50">
      <!-- Subtle Paper Texture Overlay -->
      <img 
        src="/assets/images/Hero Section.svg" 
        alt="" 
        class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-40 mix-blend-multiply"
      >

      <div class="max-w-[1440px] mx-auto px-6 lg:px-28 text-center relative z-10 space-y-4">
        <!-- Eyebrow Badge -->
        <div class="flex items-center justify-center gap-1.5 text-base sm:text-lg font-medium text-[#000104]">
          <span id="hero-badge-prefix">{initialProduct.categoryBadge}</span>
          <span id="hero-badge-pill" class="bg-[#000104] text-white text-xs sm:text-sm font-bold px-2 py-0.5 rounded tracking-wide">
            {initialProduct.badgePill}
          </span>
        </div>

        <!-- Huge Elegant Heading in Gallient -->
        <h1 id="hero-title" class="font-gallient text-5xl sm:text-7xl md:text-[84px] font-normal text-[#000104] tracking-tight leading-[1.05]">
          {initialProduct.heroSubtitle}
        </h1>
      </div>
    </section>

    <!-- ================= 2. PRODUCT MAIN DETAIL ================= -->
    <section class="py-14 sm:py-20 border-b border-neutral-200/60">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-28">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-start">
          
          <!-- Left: Big Product Image Card -->
          <div class="lg:col-span-5 bg-white rounded-2xl border border-[#E8E8E8] shadow-sm p-8 sm:p-12 flex items-center justify-center min-h-[440px] sm:min-h-[520px]">
            <img 
              id="detail-main-img"
              src={initialProduct.image} 
              alt={initialProduct.name} 
              class="max-h-[380px] sm:max-h-[440px] w-auto object-contain drop-shadow-md hover:scale-105 transition-transform duration-500"
            />
          </div>

          <!-- Right: Product Information & Controls -->
          <div class="lg:col-span-7 space-y-6 pt-2">
            <!-- Title -->
            <h2 id="detail-title" class="font-gallient text-4xl sm:text-5xl lg:text-[54px] font-normal text-[#000104] leading-tight">
              {initialProduct.name}
            </h2>

            <!-- Item Description Heading -->
            <div class="space-y-2 pt-1">
              <h3 class="font-bold text-base text-[#000104]">Item Description</h3>
              <p id="detail-desc" class="text-sm sm:text-base text-[#5E666C] leading-relaxed max-w-xl">
                {initialProduct.description}
              </p>
            </div>

            <!-- SKU & Category Row -->
            <div class="flex items-center gap-8 text-xs sm:text-sm font-medium text-[#5E666C] pt-2">
              <div>
                <span class="font-semibold text-[#000104]">SKU:</span> 
                <span id="detail-sku" class="ml-1">{initialProduct.sku}</span>
              </div>
              <div>
                <span class="font-semibold text-[#000104]">Category:</span> 
                <span id="detail-category" class="ml-1">{initialProduct.category}</span>
              </div>
            </div>

            <!-- Price Row -->
            <div class="space-y-1.5 pt-3">
              <h4 class="font-bold text-base sm:text-lg text-[#000104]">Price</h4>
              <div class="flex items-center gap-4">
                <span id="detail-price" class="text-2xl font-bold text-[#000104]">
                  $ {initialProduct.price.toFixed(2)} USD
                </span>
                <span id="detail-orig-price" class="text-lg text-neutral-400 font-medium line-through">
                  $ {initialProduct.originalPrice.toFixed(2)} USD
                </span>
              </div>
            </div>

            <!-- Quantity & Add to Cart Action -->
            <div class="space-y-4 pt-4 max-w-md">
              <!-- Quantity Input Box with Spinners -->
              <div class="inline-flex items-center border border-neutral-300 rounded bg-[#FAF8F5] px-3 py-1.5 shadow-inner">
                <button id="qty-minus" class="text-neutral-500 hover:text-black px-2 py-0.5 text-base font-bold focus:outline-none" aria-label="Decrease quantity">−</button>
                <input 
                  id="product-qty" 
                  type="number" 
                  value="1" 
                  min="1" 
                  max="99" 
                  class="w-12 text-center bg-transparent border-none font-bold text-[#000104] text-base focus:outline-none [appearance:textfield] [&::-webkit-outer-spin-button]:m-0 [&::-webkit-inner-spin-button]:m-0"
                />
                <button id="qty-plus" class="text-neutral-500 hover:text-black px-2 py-0.5 text-base font-bold focus:outline-none" aria-label="Increase quantity">+</button>
              </div>

              <!-- Add To Cart Button -->
              <div>
                <button 
                  id="detail-add-to-cart-btn"
                  class="w-full bg-[#000104] text-white text-sm font-semibold py-4 px-8 rounded shadow-md hover:bg-neutral-800 transition-smooth btn-press flex items-center justify-center gap-3 tracking-wide"
                  data-id={initialProduct.id}
                  data-name={initialProduct.name}
                  data-price={initialProduct.price}
                  data-image={initialProduct.image}
                >
                  <span>Add to Cart</span>
                </button>
              </div>
            </div>

          </div>

        </div>

        <!-- ================= 3. TABS (Product Overview / Info) ================= -->
        <div class="mt-16 sm:mt-24 pt-8 border-t border-neutral-200">
          <!-- Tab Navigation -->
          <div class="flex items-center gap-8 border-b border-neutral-200">
            <button 
              id="tab-btn-overview" 
              class="pb-3 text-base sm:text-lg font-semibold text-[#000104] border-b-2 border-[#000104] transition-colors"
            >
              Product Overview
            </button>
            <button 
              id="tab-btn-info" 
              class="pb-3 text-base sm:text-lg font-medium text-[#5E666C] border-b-2 border-transparent hover:text-[#000104] transition-colors"
            >
              Info
            </button>
          </div>

          <!-- Tab Content: Product Overview -->
          <div id="tab-content-overview" class="py-8 space-y-4 text-sm sm:text-base text-[#5E666C] leading-relaxed max-w-4xl">
            <p>
              Transform your space with the Premium Ceramic Plant Pot, a blend of style, functionality, and craftsmanship. This beautifully designed pot is crafted from high-quality ceramic, ensuring both durability and elegance. With a smooth, matte finish, it provides a refined backdrop that complements any type of greenery, from cascading pothos to vibrant snake plants.
            </p>
            <p>
              Its generous size offers ample room for plant roots to grow, promoting a healthy environment for your indoor garden. The pot is designed with a drainage hole and matching saucer to prevent overwatering, ensuring your plants thrive.
            </p>
            <p>
              Its minimalist aesthetic effortlessly fits into any decor style—whether modern, bohemian, or classic—making it a versatile choice for your home or office. Each pot is fired at high temperatures for added strength, resulting in a sturdy piece that maintains its beauty over time. Ideal for plant enthusiasts and home decorators alike, the Premium Ceramic Plant Pot is more than just a planter.
            </p>
          </div>

          <!-- Tab Content: Info -->
          <div id="tab-content-info" class="hidden py-8 space-y-4 text-sm sm:text-base text-[#5E666C] leading-relaxed max-w-4xl">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 bg-[#FAF8F5] p-6 rounded-xl border border-neutral-200">
              <div>
                <span class="block text-xs uppercase font-bold text-neutral-400">Dimensions</span>
                <span class="text-sm font-semibold text-[#000104]">14cm H x 15cm W x 15cm D</span>
              </div>
              <div>
                <span class="block text-xs uppercase font-bold text-neutral-400">Weight</span>
                <span class="text-sm font-semibold text-[#000104]">850 grams</span>
              </div>
              <div>
                <span class="block text-xs uppercase font-bold text-neutral-400">Material</span>
                <span class="text-sm font-semibold text-[#000104]">100% High-fire Ceramic Glaze & Terracotta</span>
              </div>
              <div>
                <span class="block text-xs uppercase font-bold text-neutral-400">Care Instructions</span>
                <span class="text-sm font-semibold text-[#000104]">Wipe clean with a damp cloth. Hand wash recommended.</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- ================= 4. SIMILAR PRODUCTS SECTION ================= -->
    <section class="py-16 sm:py-24 bg-white">
      <div class="max-w-[1440px] mx-auto px-6 lg:px-28 space-y-10">
        
        <!-- Header -->
        <div class="space-y-2 border-b border-neutral-200 pb-6">
          <span class="text-xs font-bold text-[#5E666C] tracking-widest uppercase">TRENDING STYLES</span>
          <h3 class="font-gallient text-4xl sm:text-5xl text-[#000104] font-normal">
            Similar Products
          </h3>
        </div>

        <!-- 4 Similar Product Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 lg:gap-8">
          {similarProducts.map((prod) => (
            <div class="bg-white rounded-2xl p-4 sm:p-5 border border-[#E8E8E8] hover:border-neutral-400 hover:shadow-md transition-smooth flex flex-col group relative overflow-hidden">
              
              <!-- Product Image Link -->
              <a href={`/product?id=${prod.id}`} class="relative w-full h-[220px] sm:h-[240px] flex items-center justify-center p-3 rounded-xl bg-neutral-50/50 group-hover:bg-neutral-50 transition-colors">
                <img 
                  src={prod.image} 
                  alt={prod.name} 
                  class="max-h-full max-w-full object-contain group-hover:scale-105 transition-smooth duration-500 drop-shadow-sm"
                />

                <!-- Add to Cart Hover Button Overlay -->
                <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-smooth bg-black/10 rounded-xl">
                  <button 
                    class="similar-add-to-cart-btn bg-[#000104] text-white text-xs font-semibold px-6 py-2.5 rounded shadow-lg hover:bg-neutral-800 transition-smooth btn-press"
                    data-id={prod.id}
                    data-name={prod.name}
                    data-price={prod.price}
                    data-image={prod.image}
                    onclick="event.preventDefault(); event.stopPropagation();"
                  >
                    Add to Cart
                  </button>
                </div>
              </a>

              <!-- Product Details -->
              <div class="pt-4 space-y-1">
                <!-- 5 Stars Rating -->
                <div class="flex items-center text-amber-400 text-sm gap-0.5">
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                  <span>★</span>
                </div>

                <!-- Product Title Link -->
                <a href={`/product?id=${prod.id}`} class="block font-bold text-base text-[#000104] group-hover:text-neutral-700 transition-colors">
                  {prod.name}
                </a>

                <!-- Price -->
                <p class="text-sm font-semibold text-[#5E666C]">
                  ${prod.price}
                </p>
              </div>

            </div>
          ))}
        </div>

      </div>
    </section>

    <!-- ================= 5. NEWSLETTER ================= -->
    <Newsletter />

  </main>

  <Footer />
  <CartDrawer />
</Layout>

<script>
  import { getProductById } from '../data/mockData.js';

  // 1. Dynamic product resolver via URL query param (?id=sp-1 etc.)
  function initProductPage() {
    const urlParams = new URLSearchParams(window.location.search);
    const productId = urlParams.get('id');

    if (productId) {
      const prod = getProductById(productId);
      if (prod) {
        document.title = `${prod.name} — Earthware Ceramic Pot Website`;
        
        const heroBadgePrefix = document.getElementById('hero-badge-prefix');
        const heroBadgePill = document.getElementById('hero-badge-pill');
        const heroTitle = document.getElementById('hero-title');
        const detailImg = document.getElementById('detail-main-img') as HTMLImageElement;
        const detailTitle = document.getElementById('detail-title');
        const detailDesc = document.getElementById('detail-desc');
        const detailSku = document.getElementById('detail-sku');
        const detailCat = document.getElementById('detail-category');
        const detailPrice = document.getElementById('detail-price');
        const detailOrigPrice = document.getElementById('detail-orig-price');
        const addToCartBtn = document.getElementById('detail-add-to-cart-btn') as HTMLButtonElement;

        if (heroBadgePrefix) heroBadgePrefix.textContent = prod.categoryBadge;
        if (heroBadgePill) heroBadgePill.textContent = prod.badgePill;
        if (heroTitle) heroTitle.textContent = prod.heroSubtitle || prod.name;
        if (detailImg) {
          detailImg.src = prod.image;
          detailImg.alt = prod.name;
        }
        if (detailTitle) detailTitle.textContent = prod.name;
        if (detailDesc) detailDesc.textContent = prod.description;
        if (detailSku) detailSku.textContent = prod.sku;
        if (detailCat) detailCat.textContent = prod.category;
        
        const formattedPrice = typeof prod.price === 'number' ? prod.price.toFixed(2) : prod.price;
        const formattedOrig = typeof prod.originalPrice === 'number' ? prod.originalPrice.toFixed(2) : prod.originalPrice;
        const curr = prod.currency || '$';

        if (detailPrice) detailPrice.textContent = `${curr} ${formattedPrice} USD`;
        if (detailOrigPrice) detailOrigPrice.textContent = `${curr} ${formattedOrig} USD`;
        
        if (addToCartBtn) {
          addToCartBtn.dataset.id = String(prod.id);
          addToCartBtn.dataset.name = prod.name;
          addToCartBtn.dataset.price = String(prod.price);
          addToCartBtn.dataset.image = prod.image;
        }
      }
    }

    // 2. Quantity selector buttons
    const qtyInput = document.getElementById('product-qty') as HTMLInputElement;
    const qtyMinus = document.getElementById('qty-minus');
    const qtyPlus = document.getElementById('qty-plus');

    if (qtyMinus && qtyInput) {
      qtyMinus.onclick = () => {
        const val = parseInt(qtyInput.value) || 1;
        if (val > 1) qtyInput.value = String(val - 1);
      };
    }
    if (qtyPlus && qtyInput) {
      qtyPlus.onclick = () => {
        const val = parseInt(qtyInput.value) || 1;
        qtyInput.value = String(val + 1);
      };
    }

    // 3. Add to Cart for the main product detail
    const detailAddToCartBtn = document.getElementById('detail-add-to-cart-btn');
    if (detailAddToCartBtn) {
      detailAddToCartBtn.onclick = () => {
        const id = detailAddToCartBtn.getAttribute('data-id');
        const name = detailAddToCartBtn.getAttribute('data-name');
        const price = parseFloat(detailAddToCartBtn.getAttribute('data-price') || '100');
        const image = detailAddToCartBtn.getAttribute('data-image');
        const quantity = qtyInput ? (parseInt(qtyInput.value) || 1) : 1;

        window.dispatchEvent(new CustomEvent('cart:add', {
          detail: { id, name, price, image, quantity }
        }));
      };
    }

    // 4. Add to Cart for similar products
    document.querySelectorAll('.similar-add-to-cart-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const id = btn.getAttribute('data-id');
        const name = btn.getAttribute('data-name');
        const price = parseFloat(btn.getAttribute('data-price') || '100');
        const image = btn.getAttribute('data-image');

        window.dispatchEvent(new CustomEvent('cart:add', {
          detail: { id, name, price, image, quantity: 1 }
        }));
      });
    });

    // 5. Tabs switching (Product Overview / Info)
    const tabBtnOverview = document.getElementById('tab-btn-overview');
    const tabBtnInfo = document.getElementById('tab-btn-info');
    const contentOverview = document.getElementById('tab-content-overview');
    const contentInfo = document.getElementById('tab-content-info');

    if (tabBtnOverview && tabBtnInfo && contentOverview && contentInfo) {
      tabBtnOverview.onclick = () => {
        tabBtnOverview.className = 'pb-3 text-base sm:text-lg font-semibold text-[#000104] border-b-2 border-[#000104] transition-colors';
        tabBtnInfo.className = 'pb-3 text-base sm:text-lg font-medium text-[#5E666C] border-b-2 border-transparent hover:text-[#000104] transition-colors';
        contentOverview.classList.remove('hidden');
        contentInfo.classList.add('hidden');
      };

      tabBtnInfo.onclick = () => {
        tabBtnInfo.className = 'pb-3 text-base sm:text-lg font-semibold text-[#000104] border-b-2 border-[#000104] transition-colors';
        tabBtnOverview.className = 'pb-3 text-base sm:text-lg font-medium text-[#5E666C] border-b-2 border-transparent hover:text-[#000104] transition-colors';
        contentInfo.classList.remove('hidden');
        contentOverview.classList.add('hidden');
      };
    }
  }

  // Run on mount
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProductPage);
  } else {
    initProductPage();
  }
</script>

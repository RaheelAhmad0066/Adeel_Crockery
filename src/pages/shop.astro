---
// shop.astro - Clean, Modular, Backend-Friendly Architecture
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Newsletter from '../components/Newsletter.astro';
import Footer from '../components/Footer.astro';
import CartDrawer from '../components/CartDrawer.astro';
import ProductCard from '../components/ProductCard.astro';
import ShopFilters from '../components/ShopFilters.astro';

// Clean Data Import (Ready to be replaced with backend API fetch)
import { ceramicPotteryProducts, categoryProducts } from '../data/shopData.js';
const activeProducts = ceramicPotteryProducts;
---


<Layout title="Shop — Earthware">
  <Navbar active="shop" />

  <main class="bg-[#FDFBF7] min-h-screen">

    <!-- ========================================================================= -->
    <!-- 1. GENERAL SHOP VIEW (When clicking "Shop" from top Navbar /shop)          -->
    <!-- Matches Figma & user screenshot media_1791876894512_95b91dc3.png          -->
    <!-- ========================================================================= -->
    <div id="general-shop-view">
      
      <!-- Hero Texture Banner -->
      <section class="relative overflow-hidden py-14 sm:py-20 bg-[#F4EBE1] border-b border-neutral-200/50">
        <img 
          src="/assets/images/Hero Section.svg" 
          alt="" 
          class="absolute inset-0 w-full h-full object-cover pointer-events-none opacity-60 mix-blend-multiply"
        />

        <div class="max-w-[1440px] mx-auto px-6 lg:px-20 text-center relative z-10 space-y-3">
          <div class="inline-flex items-center gap-2 text-xs sm:text-sm text-[#000104] font-medium tracking-wide">
            <span>Unique handmade</span>
            <span class="bg-[#000104] text-white px-2.5 py-0.5 rounded text-xs font-semibold">pottery</span>
          </div>

          <h1 class="font-gallient text-4xl sm:text-6xl md:text-[68px] font-normal text-[#000104] tracking-tight">
            Discover Our Products
          </h1>
        </div>
      </section>

      <!-- Products Grid Section with Centered Filter Dropdowns -->
      <section class="py-12 sm:py-16">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-20 space-y-12">

          <!-- Centered Filter Pill Bar -->
          <ShopFilters />

          <!-- Products Grid -->
          <div id="shop-products-grid" class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
            {activeProducts.map((prod) => (
              <ProductCard 
                id={prod.id}
                name={prod.name}
                price={prod.price}
                priceDisplay={prod.priceDisplay}
                image={prod.image}
                rating={prod.rating}
                type={prod.type}
                material={prod.material}
                category={prod.category}
              />
            ))}
          </div>

          <!-- Empty State Container -->
          <div id="no-products-empty" class="hidden text-center py-16 space-y-4">
            <div class="text-5xl">🏺</div>
            <h3 class="text-xl font-bold text-[#000104]">No products match your selected filters</h3>
            <p class="text-sm text-[#5E666C]">Try clearing some filters to explore our collection.</p>
            <button type="button" id="empty-clear-filters-btn" class="bg-[#000104] text-white text-xs font-semibold px-6 py-2.5 rounded hover:bg-neutral-800 transition-smooth">
              Clear All Filters
            </button>
          </div>

          <!-- Pagination Controls -->
          <div class="pt-6 flex items-center justify-between border-t border-neutral-200/60">
            <div class="flex items-center gap-1.5 sm:gap-2">
              <span class="w-9 h-9 rounded bg-[#000104] text-white font-bold text-sm flex items-center justify-center shadow-sm">1</span>
              <button class="w-9 h-9 rounded text-[#5E666C] hover:text-[#000104] hover:bg-neutral-100 font-medium text-sm flex items-center justify-center transition-colors">2</button>
              <button class="w-9 h-9 rounded text-[#5E666C] hover:text-[#000104] hover:bg-neutral-100 font-medium text-sm flex items-center justify-center transition-colors">3</button>
              <span class="w-9 h-9 text-[#8E959B] text-sm flex items-center justify-center">...</span>
              <button class="w-9 h-9 rounded text-[#5E666C] hover:text-[#000104] hover:bg-neutral-100 font-medium text-sm flex items-center justify-center transition-colors">8</button>
            </div>

            <button class="bg-[#000104] text-white text-xs sm:text-sm font-semibold px-6 sm:px-8 py-2.5 rounded shadow-sm hover:bg-neutral-800 transition-smooth btn-press">
              Next
            </button>
          </div>

        </div>
      </section>

      <!-- Flash Sale Banner Section -->
      <section id="flash-sale-banner-section" class="py-16 sm:py-24 bg-[#262E35] transition-all duration-300">
        <div class="max-w-[1240px] mx-auto px-6 lg:px-12">
          <div class="relative rounded-2xl overflow-hidden min-h-[380px] sm:min-h-[460px] flex items-center justify-center shadow-2xl border border-neutral-700/50">
            <img 
              src="/assets/images/flash-sale-banner.svg" 
              alt="Artisan Crafted Ceramic Pots" 
              class="absolute inset-0 w-full h-full object-cover"
            />
            <div class="absolute inset-0 bg-black/25"></div>
            <div class="relative z-10 bg-white p-8 sm:p-12 md:p-14 max-w-[620px] mx-4 text-center space-y-4 shadow-2xl rounded-sm">
              <h3 class="text-base sm:text-lg font-bold tracking-[0.25em] text-[#000104] uppercase">
                FLASH SALE
              </h3>
              <p class="text-xs sm:text-[13px] text-[#5E666C] leading-relaxed">
                For a limited time, discover artisan-crafted ceramic pots at unbeatable prices. These unique, handcrafted pieces add warmth and elegance to any space, but they won't last long—grab yours before they're gone!
              </p>
              <div class="pt-2">
                <a 
                  href="#shop-products-grid" 
                  class="inline-block bg-[#000104] text-white text-xs font-semibold px-8 py-3.5 rounded hover:bg-neutral-800 transition-smooth btn-press shadow-sm"
                >
                  Shop Now
                </a>
              </div>
            </div>
          </div>
        </div>
      </section>

    </div>

    <!-- ========================================================================= -->
    <!-- 2. CATEGORY VIEW (When clicking category links under navbar ?cat=...)       -->
    <!-- ========================================================================= -->
    <div id="category-shop-view" class="hidden">
      
      <section class="pt-10 sm:pt-14 pb-6 border-b border-neutral-200/50">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-20 space-y-6">
          
          <!-- Dynamic Category Heading -->
          <h1 id="shop-category-heading" class="font-serif text-3xl sm:text-5xl md:text-[56px] font-normal text-[#1F2937] tracking-tight">
            Brass Serving / Thaal
          </h1>

          <!-- Subheader Quick Filter Bar -->
          <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4 text-xs sm:text-sm text-[#4B5563] border-t border-neutral-200/60 pt-5">
            <div class="flex items-center gap-6">
              <span class="font-medium text-[#111827]">Filter:</span>
              
              <div class="relative group">
                <button class="flex items-center gap-1.5 hover:text-black font-medium transition-colors">
                  <span>Availability</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
              </div>

              <div class="relative group">
                <button class="flex items-center gap-1.5 hover:text-black font-medium transition-colors">
                  <span>Price</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
              </div>
            </div>

            <div class="flex items-center gap-6">
              <div class="flex items-center gap-2">
                <span class="font-medium text-[#111827]">Sort by:</span>
                <button class="flex items-center gap-1.5 hover:text-black font-medium transition-colors">
                  <span>Best selling</span>
                  <svg class="w-3.5 h-3.5" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd"/>
                  </svg>
                </button>
              </div>
              <span class="text-[#78716C]">{categoryProducts.length} of {categoryProducts.length} products</span>
            </div>
          </div>

        </div>
      </section>

      <!-- Category Products Grid -->
      <section class="py-10 sm:py-14">
        <div class="max-w-[1440px] mx-auto px-6 lg:px-20 space-y-10">
          <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
            {categoryProducts.map((prod) => (
              <ProductCard 
                id={prod.id}
                name={prod.name}
                price={prod.price}
                priceDisplay={prod.priceDisplay}
                image={prod.image}
                isSoldOut={prod.isSoldOut}
                category={prod.category}
                isSerif={true}
              />
            ))}
          </div>
        </div>
      </section>

    </div>

    <!-- Newsletter -->
    <Newsletter />

  </main>

  <Footer />
  <CartDrawer />
</Layout>

<script>
  import { categoryTitles } from '../data/shopData.js';

  // 1. Navigation & View Switching Engine
  function switchView() {
    const params = new URLSearchParams(window.location.search);
    const cat = params.get('cat');
    const generalView = document.getElementById('general-shop-view');
    const categoryView = document.getElementById('category-shop-view');
    const heading = document.getElementById('shop-category-heading');

    if (cat) {
      // Show Category View
      if (generalView) generalView.classList.add('hidden');
      if (categoryView) categoryView.classList.remove('hidden');

      const title = (categoryTitles as Record<string, string>)[cat] || cat.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      if (heading) heading.textContent = title;
      document.title = `${title} — Earthware`;
    } else {
      // Show General Shop View
      if (categoryView) categoryView.classList.add('hidden');
      if (generalView) generalView.classList.remove('hidden');
      document.title = `Shop — Earthware`;
    }
  }

  function setupNavigationInterception() {
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement)?.closest('a') as HTMLAnchorElement | null;
      if (!target) return;

      const url = new URL(target.href, window.location.origin);
      if (url.pathname === '/shop') {
        e.preventDefault();
        window.history.pushState({}, '', target.href);
        switchView();
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    });

    window.addEventListener('popstate', switchView);
  }

  // 2. Dropdowns & Filtering Functionality for Shop View
  function initShopFilters() {
    const filterState = {
      sort: 'default',
      type: 'all',
      material: 'all',
      priceRange: 'all'
    };

    const dropdownGroups = document.querySelectorAll('.filter-dropdown-group');
    const cards = Array.from(document.querySelectorAll('#shop-products-grid .shop-product-card')) as HTMLElement[];
    const grid = document.getElementById('shop-products-grid');
    const emptyState = document.getElementById('no-products-empty');
    const countText = document.getElementById('results-count-text');
    const resetBtn = document.getElementById('reset-all-filters-btn');
    const emptyClearBtn = document.getElementById('empty-clear-filters-btn');

    if (!dropdownGroups.length) return;

    dropdownGroups.forEach(group => {
      const triggerBtn = group.querySelector('.filter-trigger-btn');
      const menu = group.querySelector('.dropdown-menu');
      const chevron = group.querySelector('.chevron');

      if (triggerBtn && menu) {
        triggerBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const isClosed = menu.classList.contains('hidden');

          dropdownGroups.forEach(other => {
            other.querySelector('.dropdown-menu')?.classList.add('hidden');
            other.querySelector('.chevron')?.classList.remove('rotate-180');
          });

          if (isClosed) {
            menu.classList.remove('hidden');
            chevron?.classList.add('rotate-180');
          }
        });
      }

      const optionButtons = group.querySelectorAll('.filter-option-btn');
      const filterType = group.getAttribute('data-filter-type') as keyof typeof filterState;
      const labelSpan = group.querySelector('.btn-label');

      optionButtons.forEach(optBtn => {
        optBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          const val = optBtn.getAttribute('data-value') || 'all';
          const text = optBtn.textContent?.trim() || '';

          filterState[filterType] = val;

          if (labelSpan) {
            if (val === 'all' || val === 'default') {
              const defaultLabels: Record<string, string> = {
                sort: 'Sort By',
                type: 'Product Type',
                material: 'Material',
                priceRange: 'Price Range'
              };
              labelSpan.textContent = defaultLabels[filterType] || text;
            } else {
              labelSpan.textContent = text;
            }
          }

          menu?.classList.add('hidden');
          chevron?.classList.remove('rotate-180');

          applyFilters();
        });
      });
    });

    document.addEventListener('click', () => {
      dropdownGroups.forEach(group => {
        group.querySelector('.dropdown-menu')?.classList.add('hidden');
        group.querySelector('.chevron')?.classList.remove('rotate-180');
      });
    });

    function applyFilters() {
      let visible = cards.filter(card => {
        const type = card.dataset.type || '';
        const material = card.dataset.material || '';
        const price = Number(card.dataset.price) || 0;

        const matchType = filterState.type === 'all' || type === filterState.type;
        const matchMaterial = filterState.material === 'all' || material === filterState.material;

        let matchPrice = true;
        if (filterState.priceRange === 'under-100') matchPrice = price < 100;
        else if (filterState.priceRange === '100-200') matchPrice = price >= 100 && price <= 200;

        return matchType && matchMaterial && matchPrice;
      });

      if (filterState.sort === 'price-asc') {
        visible.sort((a, b) => Number(a.dataset.price) - Number(b.dataset.price));
      } else if (filterState.sort === 'price-desc') {
        visible.sort((a, b) => Number(b.dataset.price) - Number(a.dataset.price));
      } else if (filterState.sort === 'name-asc') {
        visible.sort((a, b) => (a.dataset.name || '').localeCompare(b.dataset.name || ''));
      }

      cards.forEach(c => c.classList.add('hidden'));

      if (grid) {
        visible.forEach(c => {
          c.classList.remove('hidden');
          grid.appendChild(c);
        });
      }

      if (countText) countText.textContent = `Showing ${visible.length} products`;

      if (emptyState && grid) {
        if (visible.length === 0) {
          emptyState.classList.remove('hidden');
          grid.classList.add('hidden');
        } else {
          emptyState.classList.add('hidden');
          grid.classList.remove('hidden');
        }
      }

      const isFiltered = Object.entries(filterState).some(([k, v]) => v !== 'all' && v !== 'default');
      if (resetBtn) {
        if (isFiltered) resetBtn.classList.remove('hidden');
        else resetBtn.classList.add('hidden');
      }
    }

    function resetFilters() {
      filterState.sort = 'default';
      filterState.type = 'all';
      filterState.material = 'all';
      filterState.priceRange = 'all';

      dropdownGroups.forEach(group => {
        const filterType = group.getAttribute('data-filter-type') || '';
        const labelSpan = group.querySelector('.btn-label');
        if (labelSpan) {
          const defaultLabels: Record<string, string> = {
            sort: 'Sort By',
            type: 'Product Type',
            material: 'Material',
            priceRange: 'Price Range'
          };
          labelSpan.textContent = defaultLabels[filterType] || '';
        }
      });

      applyFilters();
    }

    if (resetBtn) resetBtn.addEventListener('click', resetFilters);
    if (emptyClearBtn) emptyClearBtn.addEventListener('click', resetFilters);
  }

  function init() {
    switchView();
    setupNavigationInterception();
    initShopFilters();

    // Dynamic fetch from Supabase
    import('../services/dbService.js').then(async ({ getAllProducts }) => {
      try {
        const liveProducts = await getAllProducts();
        if (liveProducts && liveProducts.length > 0) {
          const grid = document.getElementById('shop-products-grid');
          if (grid) {
            grid.innerHTML = '';
            liveProducts.forEach((p: any) => {
              const imgSrc = p.image && p.image.startsWith('/') ? p.image : (p.image ? `/${p.image}` : '/assets/images/prod-1.png');
              const card = document.createElement('div');
              card.className = 'shop-product-card group flex flex-col justify-between';
              card.setAttribute('data-category', (p.category || 'crockery').toLowerCase().replace(/[^a-z0-9]+/g, '-'));
              card.setAttribute('data-type', (p.subcategory || 'pottery').toLowerCase());
              card.setAttribute('data-price', (p.price || 0).toString());

              card.innerHTML = `
                <a href="/product?id=${p.id}" class="w-full aspect-square bg-[#FBF6F3] rounded-2xl p-4 sm:p-6 flex items-center justify-center border border-neutral-200/60 group-hover:border-neutral-900 group-hover:shadow-md transition-all duration-300 block">
                  <img src="${imgSrc}" alt="${p.name}" class="max-h-28 sm:max-h-40 max-w-full object-contain group-hover:scale-105 transition-transform duration-300" />
                </a>
                <div class="pt-3 sm:pt-4 space-y-1 sm:space-y-1.5 flex flex-col items-start w-full">
                  <a href="/product?id=${p.id}" class="text-xs sm:text-[15px] text-[#3C4245] font-normal truncate hover:text-[#000104] transition-colors block max-w-full">
                    ${p.name}
                  </a>
                  <div class="text-base sm:text-xl font-bold text-[#000104]">
                    PKR ${Number(p.price || 0).toLocaleString()}
                  </div>
                  <button class="add-to-cart-btn mt-1.5 inline-flex items-center gap-1.5 sm:gap-2 px-3 sm:px-4 py-1.5 border border-neutral-400 rounded text-xs font-semibold text-[#000104] hover:bg-[#000104] hover:text-white transition-smooth btn-press w-full sm:w-auto justify-center" data-id="${p.id}" data-name="${p.name}" data-price="${p.price}" data-image="${imgSrc}">
                    <img src="/assets/icons/cart.svg" alt="" class="w-3.5 h-3.5 object-contain" />
                    <span>Cart</span>
                  </button>
                </div>
              `;
              grid.appendChild(card);
            });

            // Re-attach cart listeners
            grid.querySelectorAll('.add-to-cart-btn').forEach((btn: any) => {
              btn.addEventListener('click', (e: any) => {
                e.stopPropagation();
                const id = btn.getAttribute('data-id');
                const name = btn.getAttribute('data-name');
                const price = parseFloat(btn.getAttribute('data-price') || '0');
                const image = btn.getAttribute('data-image');
                if ((window as any).addToCart) {
                  (window as any).addToCart({ id, name, price, image, quantity: 1 });
                }
              });
            });
          }
        }
      } catch (e) {
        console.warn('Shop live products fetch warning:', e);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', init);
  } else {
    init();
  }
</script>

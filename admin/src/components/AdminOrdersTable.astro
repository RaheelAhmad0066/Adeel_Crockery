---
import { adminOrdersList } from '../data/adminMockData.js';

interface Props {
  limit?: number;
  showFilters?: boolean;
}

const { limit = 10, showFilters = true } = Astro.props;
const displayOrders = adminOrdersList.slice(0, limit);
---

<div class="bg-white rounded-2xl border border-neutral-200/80 shadow-xs overflow-hidden">
  
  <!-- Header & Status Tabs -->
  <div class="p-5 border-b border-neutral-100 flex flex-col md:flex-row justify-between items-start md:items-center gap-4">
    <div>
      <h3 class="text-base font-bold text-[#000104]">Recent Customer Orders</h3>
      <p class="text-xs text-[#5E666C]">Live order status & customer delivery updates</p>
    </div>

    {showFilters && (
      <div class="flex items-center gap-1 overflow-x-auto max-w-full pb-1 text-xs font-semibold">
        <button class="order-filter-btn px-3 py-1.5 rounded-lg bg-[#000104] text-white" data-status="all">All</button>
        <button class="order-filter-btn px-3 py-1.5 rounded-lg text-neutral-600 hover:bg-neutral-100" data-status="Pending">Pending</button>
        <button class="order-filter-btn px-3 py-1.5 rounded-lg text-neutral-600 hover:bg-neutral-100" data-status="Preparing">Preparing</button>
        <button class="order-filter-btn px-3 py-1.5 rounded-lg text-neutral-600 hover:bg-neutral-100" data-status="Out for Delivery">On the Way</button>
        <button class="order-filter-btn px-3 py-1.5 rounded-lg text-neutral-600 hover:bg-neutral-100" data-status="Delivered">Delivered</button>
      </div>
    )}
  </div>

  <!-- Clean Table -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="bg-[#FAF8F5] text-neutral-500 font-bold uppercase tracking-wider text-[10px] border-b border-neutral-100">
          <th class="py-3.5 px-5">Order ID</th>
          <th class="py-3.5 px-5">Customer & Phone</th>
          <th class="py-3.5 px-5">Items Summary</th>
          <th class="py-3.5 px-5">Total (PKR)</th>
          <th class="py-3.5 px-5">Status</th>
          <th class="py-3.5 px-5 text-right">Update Status</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 text-neutral-700">
        {displayOrders.map((order) => {
          let badgeClass = 'bg-neutral-100 text-neutral-700';
          if (order.status === 'Pending') badgeClass = 'bg-amber-100 text-amber-800 border border-amber-200';
          if (order.status === 'Preparing') badgeClass = 'bg-blue-100 text-blue-800 border border-blue-200';
          if (order.status === 'Out for Delivery') badgeClass = 'bg-purple-100 text-purple-800 border border-purple-200';
          if (order.status === 'Delivered') badgeClass = 'bg-emerald-100 text-emerald-800 border border-emerald-200';

          return (
            <tr class="hover:bg-neutral-50/70 transition-colors order-row" data-status={order.status}>
              <!-- Order ID -->
              <td class="py-3.5 px-5 font-bold text-[#000104]">
                #{order.id}
                <span class="block text-[10px] text-neutral-400 font-normal">{order.time}</span>
              </td>

              <!-- Customer -->
              <td class="py-3.5 px-5">
                <span class="font-bold text-neutral-900 block">{order.customer}</span>
                <span class="text-neutral-500 text-[11px] block">{order.phone}</span>
                <span class="text-neutral-400 text-[10px] block truncate max-w-[180px]">{order.address}</span>
              </td>

              <!-- Items -->
              <td class="py-3.5 px-5">
                <span class="font-semibold text-neutral-800">{order.itemsCount} Items</span>
                <div class="text-[11px] text-neutral-500 truncate max-w-[180px]">
                  {order.items.map(it => `${it.name} (x${it.qty})`).join(', ')}
                </div>
              </td>

              <!-- Total in PKR -->
              <td class="py-3.5 px-5 font-bold text-[#000104]">
                PKR {order.total.toLocaleString()}
                <span class="block text-[10px] text-neutral-400 font-normal">{order.paymentMethod}</span>
              </td>

              <!-- Status Badge -->
              <td class="py-3.5 px-5">
                <span class={`order-badge inline-block px-2.5 py-1 rounded-full text-[11px] font-bold ${badgeClass}`}>
                  {order.status}
                </span>
              </td>

              <!-- Actions: Dropdown to Change Status -->
              <td class="py-3.5 px-5 text-right whitespace-nowrap">
                <select class="order-status-changer text-xs bg-white border border-neutral-300 rounded-lg px-2.5 py-1 text-neutral-800 focus:outline-none focus:border-black font-medium cursor-pointer">
                  <option value="Pending" selected={order.status === 'Pending'}>Pending</option>
                  <option value="Preparing" selected={order.status === 'Preparing'}>Preparing</option>
                  <option value="Out for Delivery" selected={order.status === 'Out for Delivery'}>Out for Delivery</option>
                  <option value="Delivered" selected={order.status === 'Delivered'}>Delivered</option>
                </select>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

  <div class="p-4 border-t border-neutral-100 flex items-center justify-between text-xs text-neutral-500">
    <span>Showing {displayOrders.length} recent customer orders</span>
    <a href="/orders" class="font-bold text-[#000104] hover:underline">View All Orders →</a>
  </div>

</div>

<script>
  // Filter tabs
  const filterBtns = document.querySelectorAll('.order-filter-btn');
  const rows = document.querySelectorAll('.order-row');

  filterBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      filterBtns.forEach(b => {
        b.classList.remove('bg-[#000104]', 'text-white');
        b.classList.add('text-neutral-600');
      });
      btn.classList.add('bg-[#000104]', 'text-white');
      btn.classList.remove('text-neutral-600');

      const targetStatus = btn.getAttribute('data-status');
      rows.forEach(r => {
        const rowStatus = r.getAttribute('data-status');
        if (targetStatus === 'all' || rowStatus === targetStatus) {
          (r as HTMLElement).style.display = '';
        } else {
          (r as HTMLElement).style.display = 'none';
        }
      });
    });
  });

  // Dropdown Status Changer
  document.querySelectorAll('.order-status-changer').forEach(sel => {
    sel.addEventListener('change', (e) => {
      const target = e.target as HTMLSelectElement;
      const row = target.closest('.order-row');
      const badge = row?.querySelector('.order-badge');
      if (badge && row) {
        badge.textContent = target.value;
        row.setAttribute('data-status', target.value);
        badge.className = 'order-badge inline-block px-2.5 py-1 rounded-full text-[11px] font-bold ';
        if (target.value === 'Pending') badge.className += 'bg-amber-100 text-amber-800 border border-amber-200';
        if (target.value === 'Preparing') badge.className += 'bg-blue-100 text-blue-800 border border-blue-200';
        if (target.value === 'Out for Delivery') badge.className += 'bg-purple-100 text-purple-800 border border-purple-200';
        if (target.value === 'Delivered') badge.className += 'bg-emerald-100 text-emerald-800 border border-emerald-200';
      }
    });
  });
</script>

---
interface Props {
  activeNav?: string;
}

const { activeNav = 'dashboard' } = Astro.props;
---

<!-- Desktop Sidebar -->
<aside class="hidden lg:flex flex-col w-64 bg-[#0D1117] text-white border-r border-neutral-800 flex-shrink-0 select-none">
  
  <!-- Brand / Logo Area -->
  <div class="h-16 flex items-center justify-between px-6 border-b border-neutral-800/80">
    <a href="/" class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center p-1 shadow-sm">
        <img src="/assets/icons/logo.svg" alt="Earthware" class="w-full h-full object-contain">
      </div>
      <div>
        <span class="font-bold text-sm text-white tracking-wide block leading-none">Earthware</span>
        <span class="text-[10px] text-neutral-400 font-medium uppercase tracking-wider">Store Admin CMS</span>
      </div>
    </a>
    <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
      Live
    </span>
  </div>

  <!-- Navigation Links -->
  <nav class="flex-1 px-3 py-4 space-y-1 overflow-y-auto">
    
    <div class="px-3 pb-1 text-[10px] font-bold text-neutral-500 uppercase tracking-widest">
      Store Operations
    </div>

    <!-- 1. Dashboard -->
    <a 
      href="/" 
      class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'dashboard' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
      <span>Dashboard</span>
    </a>

    <!-- 2. Home Banners (Multiple Slides) -->
    <a 
      href="/banner" 
      class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'banner' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
      <span>Hero Banners CMS</span>
    </a>

    <!-- 3. Products Inventory (CRUD + Upload + Dynamic Categories) -->
    <a 
      href="/products" 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'products' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
        <span>Products & Inventory</span>
      </div>
      <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-emerald-500/20 text-emerald-300">
        Active
      </span>
    </a>

    <!-- 4. Navbar Categories & Subcategories -->
    <a 
      href="/categories" 
      class={`flex items-center gap-3 px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'categories' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h7"/></svg>
      <span>Navbar Categories</span>
    </a>

    <!-- 5. Orders & Dispatch Tracker -->
    <a 
      href="/orders" 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'orders' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <span>Orders & Dispatch</span>
      </div>
      <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-amber-500/20 text-amber-300">
        4 Active
      </span>
    </a>

    <div class="px-3 pt-3 pb-1 text-[10px] font-bold text-neutral-500 uppercase tracking-widest">
      Store Pages Content
    </div>

    <!-- 6. Services & Inquiries (/service) -->
    <a 
      href="/services" 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'services' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
        <span>Services & Inquiries</span>
      </div>
      <span class="text-[10px] text-neutral-400 font-mono">/service</span>
    </a>

    <!-- 7. News & Blog CMS (/news) -->
    <a 
      href="/news" 
      class={`flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold transition-all ${
        activeNav === 'news' 
          ? 'bg-white/10 text-white shadow-sm border border-white/10' 
          : 'text-neutral-400 hover:text-white hover:bg-white/5'
      }`}
    >
      <div class="flex items-center gap-3">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10a2 2 0 012 2v1m2 13a2 2 0 01-2-2V7m2 13a2 2 0 002-2V9a2 2 0 00-2-2h-2m-4-3H9M7 16h6M7 8h6v4H7V8z"/></svg>
        <span>News & Articles</span>
      </div>
      <span class="text-[10px] text-neutral-400 font-mono">/news</span>
    </a>

  </nav>

  <!-- Sidebar Footer -->
  <div class="p-3 border-t border-neutral-800/80 bg-neutral-900/60 space-y-2">
    <a 
      href="http://localhost:3000" 
      target="_blank" 
      class="flex items-center justify-between px-3 py-2 rounded-lg text-xs font-semibold text-emerald-400 bg-emerald-500/10 border border-emerald-500/20 hover:bg-emerald-500/20 transition-all"
    >
      <span>Preview Live Store</span>
      <span>↗</span>
    </a>
    <div class="flex items-center gap-2.5 px-2 py-1">
      <div class="w-7 h-7 rounded-full bg-neutral-700 flex items-center justify-center font-bold text-xs text-white">
        AD
      </div>
      <div class="flex-1 min-w-0">
        <p class="text-xs font-semibold text-white truncate leading-tight">Admin Manager</p>
        <p class="text-[10px] text-neutral-400 truncate">Store Management</p>
      </div>
    </div>
  </div>

</aside>

<!-- Mobile Drawer Sidebar (Backdrop & Slide Menu) -->
<div id="admin-mob-overlay" class="fixed inset-0 bg-black/60 z-[998] opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"></div>

<aside id="admin-mob-sidebar" class="fixed top-0 left-0 h-full w-[280px] bg-[#0D1117] text-white z-[999] shadow-2xl transform -translate-x-full transition-transform duration-300 flex flex-col justify-between lg:hidden">
  
  <div class="h-16 flex items-center justify-between px-6 border-b border-neutral-800">
    <div class="flex items-center gap-2.5">
      <div class="w-8 h-8 rounded-lg bg-white flex items-center justify-center p-1">
        <img src="/assets/icons/logo.svg" alt="Earthware" class="w-full h-full object-contain">
      </div>
      <span class="font-bold text-sm text-white">Earthware Admin</span>
    </div>
    <button id="admin-close-mob-btn" class="p-1.5 text-neutral-400 hover:text-white" aria-label="Close menu">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
    </button>
  </div>

  <nav class="flex-1 px-4 py-4 space-y-2 overflow-y-auto text-xs font-semibold">
    <a href="/" class={`block px-3 py-2 rounded-lg ${activeNav === 'dashboard' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Dashboard</a>
    <a href="/banner" class={`block px-3 py-2 rounded-lg ${activeNav === 'banner' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Hero Banners CMS</a>
    <a href="/products" class={`block px-3 py-2 rounded-lg ${activeNav === 'products' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Products & Inventory</a>
    <a href="/categories" class={`block px-3 py-2 rounded-lg ${activeNav === 'categories' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Navbar Categories</a>
    <a href="/orders" class={`block px-3 py-2 rounded-lg ${activeNav === 'orders' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Orders & Dispatch</a>
    <a href="/services" class={`block px-3 py-2 rounded-lg ${activeNav === 'services' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>Services & Inquiries (/service)</a>
    <a href="/news" class={`block px-3 py-2 rounded-lg ${activeNav === 'news' ? 'bg-white/10 text-white' : 'text-neutral-400'}`}>News & Articles (/news)</a>
    <div class="pt-4 border-t border-neutral-800">
      <a href="http://localhost:3000" target="_blank" class="block px-3 py-2 text-emerald-400 font-bold">Open Storefront ↗</a>
    </div>
  </nav>

  <div class="p-4 border-t border-neutral-800 text-[11px] text-neutral-500 text-center">
    © 2024 Earthware Store Admin
  </div>
</aside>

<script>
  const openBtn = document.getElementById('admin-open-mob-btn');
  const closeBtn = document.getElementById('admin-close-mob-btn');
  const sidebar = document.getElementById('admin-mob-sidebar');
  const overlay = document.getElementById('admin-mob-overlay');

  function openSidebar() {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('opacity-0', 'pointer-events-none');
    overlay?.classList.add('opacity-100');
  }

  function closeSidebar() {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('opacity-0', 'pointer-events-none');
    overlay?.classList.remove('opacity-100');
  }

  openBtn?.addEventListener('click', openSidebar);
  closeBtn?.addEventListener('click', closeSidebar);
  overlay?.addEventListener('click', closeSidebar);
</script>

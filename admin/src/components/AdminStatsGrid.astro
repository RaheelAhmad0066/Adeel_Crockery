---
import { adminKpis } from '../data/adminMockData.js';
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
  
  <!-- 1. Total Revenue in PKR -->
  <div class="bg-white p-5 sm:p-6 rounded-2xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#5E666C] tracking-wide uppercase">Total Revenue</span>
      <span class="w-9 h-9 rounded-xl bg-emerald-50 text-emerald-600 flex items-center justify-center font-bold text-sm">
        ₨
      </span>
    </div>
    <div class="mt-4 space-y-1">
      <h3 class="text-2xl sm:text-3xl font-extrabold text-[#000104] tracking-tight">
        PKR {adminKpis.totalRevenue.toLocaleString()}
      </h3>
      <div class="flex items-center gap-1.5 text-xs text-emerald-600 font-semibold">
        <span>↑ {adminKpis.revenueGrowth}</span>
        <span class="text-neutral-400 font-normal">vs last month</span>
      </div>
    </div>
  </div>

  <!-- 2. Total Orders -->
  <div class="bg-white p-5 sm:p-6 rounded-2xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#5E666C] tracking-wide uppercase">Total Orders</span>
      <span class="w-9 h-9 rounded-xl bg-blue-50 text-blue-600 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      </span>
    </div>
    <div class="mt-4 space-y-1">
      <h3 class="text-2xl sm:text-3xl font-extrabold text-[#000104] tracking-tight">
        {adminKpis.totalOrders}
      </h3>
      <div class="flex items-center gap-1.5 text-xs text-blue-600 font-semibold">
        <span>↑ {adminKpis.ordersGrowth}</span>
        <span class="text-neutral-400 font-normal">orders completed</span>
      </div>
    </div>
  </div>

  <!-- 3. Active Live Deliveries (Foodpanda Tracker Sync) -->
  <div class="bg-white p-5 sm:p-6 rounded-2xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#5E666C] tracking-wide uppercase">Active Deliveries</span>
      <span class="w-9 h-9 rounded-xl bg-purple-50 text-purple-600 flex items-center justify-center">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      </span>
    </div>
    <div class="mt-4 space-y-1">
      <div class="flex items-center gap-2">
        <h3 class="text-2xl sm:text-3xl font-extrabold text-[#000104] tracking-tight">
          {adminKpis.activeDeliveries}
        </h3>
        <span class="relative flex h-2.5 w-2.5">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-purple-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-purple-600"></span>
        </span>
      </div>
      <div class="text-xs text-purple-600 font-semibold">
        Live on Google Maps
      </div>
    </div>
  </div>

  <!-- 4. Low Stock Alerts -->
  <div class="bg-white p-5 sm:p-6 rounded-2xl border border-neutral-200/80 shadow-sm flex flex-col justify-between hover:shadow-md transition-shadow">
    <div class="flex items-center justify-between">
      <span class="text-xs font-semibold text-[#5E666C] tracking-wide uppercase">Stock Attention</span>
      <span class="w-9 h-9 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center font-bold text-sm">
        ⚠️
      </span>
    </div>
    <div class="mt-4 space-y-1">
      <h3 class="text-2xl sm:text-3xl font-extrabold text-[#000104] tracking-tight">
        {adminKpis.lowStockItems} Items
      </h3>
      <div class="text-xs text-amber-600 font-semibold">
        Needs inventory restock
      </div>
    </div>
  </div>

</div>


---
import { adminKpis } from '../data/adminMockData.js';
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
  
  <!-- 1. Total Sales in PKR -->
  <div class="bg-white p-5 rounded-2xl border border-neutral-200/80 shadow-xs flex items-center justify-between">
    <div>
      <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider block">Total Sales</span>
      <h3 id="kpi-total-sales" class="text-xl sm:text-2xl font-bold text-[#000104] mt-1">
        PKR {adminKpis.totalRevenue.toLocaleString()}
      </h3>
      <span class="text-[11px] text-emerald-600 font-semibold mt-0.5 inline-block">↑ Live Sales from Supabase</span>
    </div>
    <div class="w-10 h-10 rounded-xl bg-emerald-50 text-emerald-700 flex items-center justify-center font-bold text-sm">
      ₨
    </div>
  </div>

  <!-- 2. Total Orders -->
  <div class="bg-white p-5 rounded-2xl border border-neutral-200/80 shadow-xs flex items-center justify-between">
    <div>
      <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider block">Total Orders</span>
      <h3 id="kpi-total-orders" class="text-xl sm:text-2xl font-bold text-[#000104] mt-1">
        {adminKpis.totalOrders}
      </h3>
      <span class="text-[11px] text-blue-600 font-semibold mt-0.5 inline-block">Customer placed orders</span>
    </div>
    <div class="w-10 h-10 rounded-xl bg-blue-50 text-blue-700 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
    </div>
  </div>

  <!-- 3. Active Deliveries -->
  <div class="bg-white p-5 rounded-2xl border border-neutral-200/80 shadow-xs flex items-center justify-between">
    <div>
      <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider block">Active Deliveries</span>
      <h3 id="kpi-active-deliv" class="text-xl sm:text-2xl font-bold text-[#000104] mt-1">
        {adminKpis.activeDeliveries}
      </h3>
      <span class="text-[11px] text-purple-600 font-semibold mt-0.5 inline-block">On the way to customers</span>
    </div>
    <div class="w-10 h-10 rounded-xl bg-purple-50 text-purple-700 flex items-center justify-center">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
    </div>
  </div>

  <!-- 4. Low Stock Alert -->
  <div class="bg-white p-5 rounded-2xl border border-neutral-200/80 shadow-xs flex items-center justify-between">
    <div>
      <span class="text-xs font-semibold text-neutral-500 uppercase tracking-wider block">Low Stock Alert</span>
      <h3 id="kpi-low-stock" class="text-xl sm:text-2xl font-bold text-amber-700 mt-1">
        {adminKpis.lowStockItems} Items
      </h3>
      <span class="text-[11px] text-amber-600 font-medium mt-0.5 inline-block">Need restocking</span>
    </div>
    <div class="w-10 h-10 rounded-xl bg-amber-50 text-amber-700 flex items-center justify-center font-bold text-sm">
      ⚠️
    </div>
  </div>

</div>

<script>
  import { getAllOrders, getAllProducts } from '../services/dbService.js';
  Promise.all([getAllOrders(), getAllProducts()]).then(([orders, prods]: [any[], any[]]) => {
    if (orders && orders.length > 0) {
      const totalSales = orders.reduce((sum: number, o: any) => sum + (parseFloat(o.total) || 0), 0);
      const totalOrdersEl = document.getElementById('kpi-total-orders');
      const totalSalesEl = document.getElementById('kpi-total-sales');
      const activeDelivEl = document.getElementById('kpi-active-deliv');
      if (totalSalesEl) totalSalesEl.textContent = `PKR ${totalSales.toLocaleString()}`;
      if (totalOrdersEl) totalOrdersEl.textContent = orders.length.toString();
      if (activeDelivEl) {
        const activeCount = orders.filter((o: any) => o.status === 'Out for Delivery' || o.status === 'Preparing').length;
        activeDelivEl.textContent = activeCount.toString();
      }
    }
    if (prods && prods.length > 0) {
      const lowCount = prods.filter((p: any) => (p.stock || 0) <= 6).length;
      const lowEl = document.getElementById('kpi-low-stock');
      if (lowEl) lowEl.textContent = `${lowCount} Items`;
    }
  }).catch(() => {});
</script>


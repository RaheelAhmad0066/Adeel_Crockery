---
interface Props {
  activeNav?: string;
}

const { activeNav = 'dashboard' } = Astro.props;

const titles: Record<string, string> = {
  dashboard: 'Store Dashboard Overview',
  orders: 'Order Processing & Live Dispatch',
  products: 'Products & Inventory Management',
  customers: 'Customer Directory',
  analytics: 'Revenue & Sales Performance'
};

const currentTitle = titles[activeNav] || 'Admin Portal';
---

<header class="h-16 bg-white border-b border-neutral-200 px-4 sm:px-6 lg:px-8 flex items-center justify-between flex-shrink-0 z-30">
  
  <!-- Left Title / Breadcrumb & Mobile Toggle -->
  <div class="flex items-center gap-3">
    <!-- Mobile Hamburger -->
    <button 
      id="admin-open-mob-btn" 
      class="lg:hidden p-2 text-neutral-600 hover:text-black hover:bg-neutral-100 rounded-lg transition-colors"
      aria-label="Open sidebar"
    >
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>

    <div>
      <h1 class="text-base sm:text-lg font-bold text-[#000104] leading-tight">
        {currentTitle}
      </h1>
      <p class="text-[11px] text-[#5E666C] hidden sm:block">
        Earthware Ceramic & Crockery Official Portal
      </p>
    </div>
  </div>

  <!-- Right Actions -->
  <div class="flex items-center gap-3 sm:gap-4">
    
    <!-- Quick Search Input (Desktop) -->
    <div class="hidden md:flex items-center relative">
      <span class="absolute left-3 text-neutral-400 pointer-events-none">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
      </span>
      <input 
        type="text" 
        placeholder="Search orders, SKU, customer..." 
        class="bg-[#F8F9FA] border border-neutral-200 rounded-full pl-9 pr-4 py-1.5 text-xs text-neutral-800 placeholder:text-neutral-400 focus:outline-none focus:border-black focus:ring-1 focus:ring-black w-60 transition-all"
      />
    </div>

    <!-- Notification Bell with Active Indicator -->
    <button class="relative p-2 text-neutral-500 hover:text-black hover:bg-neutral-100 rounded-full transition-colors" aria-label="Notifications">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.8" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/>
      </svg>
      <span class="absolute top-1.5 right-1.5 w-2 h-2 rounded-full bg-red-500 ring-2 ring-white animate-pulse"></span>
    </button>

    <!-- Visit Live Store Pill Button -->
    <a 
      href="/" 
      target="_blank" 
      class="inline-flex items-center gap-1.5 px-3 py-1.5 bg-[#000104] text-white rounded-lg text-xs font-semibold hover:bg-neutral-800 transition-smooth btn-press shadow-sm"
    >
      <span>Live Store</span>
      <span class="text-[10px]">↗</span>
    </a>

  </div>

</header>

<script>
  // Mobile drawer open/close
  const openBtn = document.getElementById('admin-open-mob-btn');
  const closeBtn = document.getElementById('admin-close-mob-btn');
  const sidebar = document.getElementById('admin-mob-sidebar');
  const overlay = document.getElementById('admin-mob-overlay');

  const openDrawer = () => {
    if (sidebar && overlay) {
      sidebar.classList.remove('-translate-x-full');
      overlay.classList.remove('opacity-0', 'pointer-events-none');
    }
  };

  const closeDrawer = () => {
    if (sidebar && overlay) {
      sidebar.classList.add('-translate-x-full');
      overlay.classList.add('opacity-0', 'pointer-events-none');
    }
  };

  if (openBtn) openBtn.addEventListener('click', openDrawer);
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  if (overlay) overlay.addEventListener('click', closeDrawer);
</script>


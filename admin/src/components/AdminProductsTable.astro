---
import { adminProductsList } from '../data/adminMockData.js';

interface Props {
  limit?: number;
}

const { limit = 10 } = Astro.props;
const displayProducts = adminProductsList.slice(0, limit);
---

<div class="bg-white rounded-2xl border border-neutral-200/80 shadow-sm overflow-hidden space-y-4">
  
  <!-- Header with Search & Add Product Button -->
  <div class="p-5 sm:p-6 border-b border-neutral-100 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4">
    <div>
      <h3 class="text-base sm:text-lg font-bold text-[#000104]">Inventory & Products</h3>
      <p class="text-xs text-[#5E666C]">Manage pottery items, pricing in PKR, and stock thresholds</p>
    </div>

    <div class="flex items-center gap-3 w-full sm:w-auto">
      <button 
        id="open-add-product-modal"
        class="inline-flex items-center gap-2 bg-[#000104] text-white px-4 py-2 rounded-xl text-xs font-semibold hover:bg-neutral-800 transition-smooth btn-press shadow-sm w-full sm:w-auto justify-center"
      >
        <span>+ Add New Product</span>
      </button>
    </div>
  </div>

  <!-- Products Table -->
  <div class="overflow-x-auto">
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="bg-[#FAF8F5] text-neutral-500 font-bold uppercase tracking-wider text-[10px] border-b border-neutral-100">
          <th class="py-3 px-5">Product</th>
          <th class="py-3 px-5">Category</th>
          <th class="py-3 px-5">Retail Price</th>
          <th class="py-3 px-5">Cost Price</th>
          <th class="py-3 px-5">Stock Level</th>
          <th class="py-3 px-5">Status</th>
          <th class="py-3 px-5 text-right">Actions</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-neutral-100 text-neutral-700">
        {displayProducts.map((prod) => {
          let badgeClass = 'bg-emerald-100 text-emerald-800';
          if (prod.status === 'Low Stock') badgeClass = 'bg-amber-100 text-amber-800';
          if (prod.status === 'Out of Stock') badgeClass = 'bg-red-100 text-red-800';

          return (
            <tr class="hover:bg-neutral-50/70 transition-colors">
              <!-- Product Image & Title -->
              <td class="py-3.5 px-5">
                <div class="flex items-center gap-3">
                  <div class="w-11 h-11 rounded-lg bg-[#FAF8F5] border border-neutral-200/70 p-1 flex items-center justify-center flex-shrink-0">
                    <img src={prod.image} alt={prod.name} class="max-h-full max-w-full object-contain" />
                  </div>
                  <div>
                    <span class="font-bold text-[#000104] block">{prod.name}</span>
                    <span class="text-[10px] text-neutral-400 font-mono">{prod.sku}</span>
                  </div>
                </div>
              </td>

              <!-- Category -->
              <td class="py-3.5 px-5">
                <span class="text-neutral-600 font-medium">{prod.category}</span>
              </td>

              <!-- Price (PKR) -->
              <td class="py-3.5 px-5 font-bold text-[#000104]">
                PKR {prod.price.toLocaleString()}
              </td>

              <!-- Cost -->
              <td class="py-3.5 px-5 text-neutral-500">
                PKR {prod.costPrice.toLocaleString()}
              </td>

              <!-- Stock Count -->
              <td class="py-3.5 px-5">
                <span class="font-bold text-neutral-800">{prod.stock}</span>
                <span class="text-[10px] text-neutral-400"> units</span>
              </td>

              <!-- Status -->
              <td class="py-3.5 px-5">
                <span class={`inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold ${badgeClass}`}>
                  {prod.status}
                </span>
              </td>

              <!-- Actions -->
              <td class="py-3.5 px-5 text-right space-x-2 whitespace-nowrap">
                <button class="text-xs font-semibold text-neutral-600 hover:text-black underline" onclick="alert('Edit modal will open for ' + this.dataset.id)" data-id={prod.id}>
                  Edit
                </button>
                <button class="text-xs font-semibold text-red-500 hover:text-red-700 underline" onclick="confirm('Delete this product?')">
                  Delete
                </button>
              </td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>

</div>

<!-- ================= ADD PRODUCT MODAL ================= -->
<div id="add-product-modal" class="fixed inset-0 bg-black/60 z-[1000] opacity-0 pointer-events-none transition-opacity duration-200 flex items-center justify-center p-4">
  <div class="bg-white rounded-2xl max-w-lg w-full p-6 space-y-5 shadow-2xl transform scale-95 transition-transform duration-200">
    <div class="flex items-center justify-between border-b pb-3">
      <h3 class="font-bold text-base text-[#000104]">Add New Crockery Product</h3>
      <button id="close-add-modal" class="text-neutral-400 hover:text-black text-lg font-bold">✕</button>
    </div>

    <form class="space-y-4 text-xs" onsubmit="event.preventDefault(); alert('Product added successfully!'); document.getElementById('add-product-modal')?.classList.add('opacity-0', 'pointer-events-none');">
      <div>
        <label class="block font-semibold mb-1">Product Name</label>
        <input type="text" required placeholder="e.g. Royal Tea Cup Set" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black" />
      </div>

      <div class="grid grid-cols-2 gap-3">
        <div>
          <label class="block font-semibold mb-1">Category</label>
          <select class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black">
            <option>Vases & Decor</option>
            <option>Crockery Deals</option>
            <option>Mugs & Cups</option>
            <option>Planters</option>
            <option>Bowls</option>
          </select>
        </div>
        <div>
          <label class="block font-semibold mb-1">SKU Code</label>
          <input type="text" required placeholder="EW-XX-00" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black font-mono" />
        </div>
      </div>

      <div class="grid grid-cols-3 gap-3">
        <div>
          <label class="block font-semibold mb-1">Price (PKR)</label>
          <input type="number" required placeholder="100" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black font-bold" />
        </div>
        <div>
          <label class="block font-semibold mb-1">Cost Price (PKR)</label>
          <input type="number" placeholder="60" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black" />
        </div>
        <div>
          <label class="block font-semibold mb-1">Stock Quantity</label>
          <input type="number" required placeholder="25" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black font-bold" />
        </div>
      </div>

      <div class="pt-3 flex items-center justify-end gap-2 border-t">
        <button type="button" id="cancel-add-btn" class="px-4 py-2 border rounded-lg text-neutral-600 hover:bg-neutral-100 font-semibold">Cancel</button>
        <button type="submit" class="px-5 py-2 bg-[#000104] text-white rounded-lg font-bold hover:bg-neutral-800">Save Product</button>
      </div>
    </form>
  </div>
</div>

<script>
  const openModal = document.getElementById('open-add-product-modal');
  const closeModal = document.getElementById('close-add-modal');
  const cancelBtn = document.getElementById('cancel-add-btn');
  const modal = document.getElementById('add-product-modal');

  const show = () => modal?.classList.remove('opacity-0', 'pointer-events-none');
  const hide = () => modal?.classList.add('opacity-0', 'pointer-events-none');

  openModal?.addEventListener('click', show);
  closeModal?.addEventListener('click', hide);
  cancelBtn?.addEventListener('click', hide);
</script>


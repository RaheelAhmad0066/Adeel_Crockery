---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminOrdersTable from '../components/AdminOrdersTable.astro';
import { adminKpis } from '../data/adminMockData.js';
---

<AdminLayout title="Orders Processing" activeNav="orders">
  
  <!-- Top Summary Strip -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white p-4 rounded-xl border border-neutral-200/80">
      <span class="text-[11px] font-bold text-neutral-400 uppercase">Pending Review</span>
      <p class="text-xl font-extrabold text-amber-600 mt-1">12 Orders</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-neutral-200/80">
      <span class="text-[11px] font-bold text-neutral-400 uppercase">Kitchen / Packing</span>
      <p class="text-xl font-extrabold text-blue-600 mt-1">8 Orders</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-neutral-200/80">
      <span class="text-[11px] font-bold text-neutral-400 uppercase">Out for Delivery</span>
      <p class="text-xl font-extrabold text-purple-600 mt-1">4 Orders</p>
    </div>
    <div class="bg-white p-4 rounded-xl border border-neutral-200/80">
      <span class="text-[11px] font-bold text-neutral-400 uppercase">Completed Today</span>
      <p class="text-xl font-extrabold text-emerald-600 mt-1">124 Orders</p>
    </div>
  </div>

  <!-- Full Orders Table -->
  <AdminOrdersTable limit={20} showFilters={true} />

</AdminLayout>


---
import AdminLayout from '../layouts/AdminLayout.astro';
import ConfirmDeleteModal from '../components/ConfirmDeleteModal.astro';
import { initialNavbarCategories, initialProducts } from '../data/storeDataModel.js';
---

<AdminLayout title="Navbar Categories & Dropdowns" activeNav="categories">
  <div class="space-y-6">
    
    <!-- Top Action Bar -->
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-2xl font-bold text-[#000104] tracking-tight">Navbar Categories & Dropdowns</h1>
        <p class="text-xs text-[#5E666C] mt-1">
          Manage header navigation menu, subcategory dropdowns (Silverware, Crockery, Brass Ware, Home Decor) and mapped products.
        </p>
      </div>

      <button 
        id="btn-add-main-cat"
        type="button" 
        class="inline-flex items-center gap-2 bg-[#000104] hover:bg-neutral-800 text-white text-xs font-semibold px-4 py-2.5 rounded-xl shadow-sm transition-all"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path>
        </svg>
        <span>+ Add Navbar Category</span>
      </button>
    </div>

    <!-- Categories Grid Container -->
    <div id="cat-cards-grid" class="grid grid-cols-1 lg:grid-cols-2 gap-5">
      {initialNavbarCategories.map((cat, catIdx) => {
        const mappedProductsCount = initialProducts.filter(p => p.category === cat.name).length;

        return (
          <div id={`cat-card-${catIdx}`} class="cat-card bg-white rounded-2xl border border-neutral-200/80 p-5 shadow-xs space-y-4 hover:border-black transition-colors" data-cat-name={cat.name} data-cat-id={cat.id} data-cat-idx={catIdx}>
            
            <div class="flex items-start justify-between border-b pb-3">
              <div>
                <div class="flex items-center gap-2">
                  <h3 class="cat-title text-base font-bold text-[#000104]">{cat.name}</h3>
                  <span class="cat-slug text-[10px] font-bold px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-700 font-mono">
                    /{cat.slug}
                  </span>
                </div>
                <p class="cat-count text-xs text-[#5E666C] mt-0.5">
                  {mappedProductsCount} active items mapped in inventory
                </p>
              </div>

              <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                  {cat.status}
                </span>
                <button class="btn-edit-main-cat text-xs font-semibold text-neutral-500 hover:text-black underline" data-idx={catIdx}>
                  Edit
                </button>
                <button class="btn-delete-main-cat text-xs font-semibold text-red-500 hover:text-red-700 underline" data-idx={catIdx}>
                  Delete
                </button>
              </div>
            </div>

            <!-- Subcategories Tag Cloud -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <span class="subcat-header text-[11px] font-bold text-neutral-400 uppercase tracking-wider">
                  Dropdown Subcategories ({cat.subcategories.length})
                </span>
                <button class="btn-add-subcat text-[11px] font-semibold text-black hover:underline" data-idx={catIdx} data-cat={cat.name}>
                  + Add Subcategory
                </button>
              </div>

              <div class="subcat-list flex flex-wrap gap-1.5" data-cat-idx={catIdx}>
                {cat.subcategories.map((sub, subIdx) => (
                  <span class="subcat-pill inline-flex items-center gap-1.5 text-xs bg-neutral-50 text-neutral-800 border border-neutral-200 px-2.5 py-1 rounded-lg font-medium hover:bg-neutral-100 transition-colors" data-sub-idx={subIdx} data-sub-name={sub.name} data-cat-id={cat.id}>
                    <span class="sub-name">{sub.name}</span>
                    <button class="btn-del-sub text-neutral-400 hover:text-red-500 text-xs ml-0.5" title="Remove subcategory">×</button>
                  </span>
                ))}
              </div>
            </div>

          </div>
        );
      })}
    </div>

  </div>

  <!-- Reusable Delete Modal -->
  <ConfirmDeleteModal 
    id="delete-category-modal" 
    title="Delete Navbar Category?" 
    description="Are you sure you want to delete this category? All its subcategories will also be removed from the store navbar." 
  />

  <!-- Add / Edit Main Category Modal -->
  <div id="category-modal" class="fixed inset-0 bg-black/60 z-[1000] opacity-0 pointer-events-none transition-opacity duration-200 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b pb-3">
        <h3 id="cat-modal-title" class="font-bold text-base text-[#000104]">Add Navbar Category</h3>
        <button id="close-cat-modal" class="text-neutral-400 hover:text-black font-bold text-lg">✕</button>
      </div>

      <form id="cat-form" class="space-y-4 text-xs">
        <input type="hidden" id="edit-cat-id" value="" />
        <input type="hidden" id="edit-cat-index" value="-1" />

        <div>
          <label class="block font-semibold mb-1 text-neutral-800">Category Display Name</label>
          <input type="text" id="cat-name-input" required placeholder="e.g. Copperware, Dinnerware" class="w-full border rounded-lg p-2.5 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black font-medium" />
        </div>

        <div>
          <label class="block font-semibold mb-1 text-neutral-800">URL Slug</label>
          <input type="text" id="cat-slug-input" required placeholder="e.g. copperware" class="w-full border rounded-lg p-2.5 bg-neutral-50 font-mono" />
        </div>

        <div class="pt-3 flex items-center justify-end gap-2 border-t">
          <button type="button" id="cancel-cat-btn" class="px-4 py-2 border rounded-lg font-semibold text-neutral-600">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-[#000104] text-white rounded-lg font-bold">Save Category</button>
        </div>
      </form>
    </div>
  </div>

  <!-- Add Subcategory Modal -->
  <div id="subcat-modal" class="fixed inset-0 bg-black/60 z-[1000] opacity-0 pointer-events-none transition-opacity duration-200 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-sm w-full p-5 space-y-4 shadow-2xl">
      <div class="flex items-center justify-between border-b pb-2">
        <h4 id="subcat-modal-title" class="font-bold text-sm text-[#000104]">Add Subcategory</h4>
        <button id="close-subcat-modal" class="text-neutral-400 hover:text-black font-bold">✕</button>
      </div>

      <form id="subcat-form" class="space-y-3 text-xs">
        <input type="hidden" id="target-cat-id" value="" />
        <input type="hidden" id="target-cat-idx" value="0" />
        <div>
          <label class="block font-semibold mb-1 text-neutral-700">Subcategory Name</label>
          <input type="text" id="subcat-name-input" required placeholder="e.g. Candle stands, Dessert Set" class="w-full border rounded-lg p-2 bg-neutral-50 focus:bg-white focus:outline-none focus:border-black" />
        </div>
        <div class="flex justify-end gap-2 pt-2">
          <button type="button" id="cancel-subcat-btn" class="px-3 py-1.5 border rounded-lg font-semibold text-neutral-600">Cancel</button>
          <button type="submit" class="px-4 py-1.5 bg-[#000104] text-white rounded-lg font-bold">Add to Dropdown</button>
        </div>
      </form>
    </div>
  </div>

</AdminLayout>

<script>
  import { 
    getNavbarCategoriesWithSubcategories, 
    saveCategory, 
    deleteCategory, 
    saveSubcategory, 
    deleteSubcategory 
  } from '../services/dbService.js';

  const catModal = document.getElementById('category-modal');
  const catModalTitle = document.getElementById('cat-modal-title');
  const catForm = document.getElementById('cat-form') as HTMLFormElement | null;
  const editCatIdInput = document.getElementById('edit-cat-id') as HTMLInputElement;
  const editCatIndexInput = document.getElementById('edit-cat-index') as HTMLInputElement;
  const catNameInput = document.getElementById('cat-name-input') as HTMLInputElement;
  const catSlugInput = document.getElementById('cat-slug-input') as HTMLInputElement;

  const subModal = document.getElementById('subcat-modal');
  const subModalTitle = document.getElementById('subcat-modal-title');
  const subForm = document.getElementById('subcat-form') as HTMLFormElement | null;
  const targetCatIdInput = document.getElementById('target-cat-id') as HTMLInputElement;
  const targetCatIdxInput = document.getElementById('target-cat-idx') as HTMLInputElement;
  const subNameInput = document.getElementById('subcat-name-input') as HTMLInputElement;

  // Reusable delete modal
  const delModal = document.getElementById('delete-category-modal');
  let pendingDeleteAction: {
    type: 'category' | 'subcategory';
    catId: string;
    subId?: string;
    subName?: string;
    domTarget?: HTMLElement | null;
  } | null = null;

  // Add Category Button
  document.getElementById('btn-add-main-cat')?.addEventListener('click', () => {
    if (editCatIdInput) editCatIdInput.value = '';
    if (editCatIndexInput) editCatIndexInput.value = '-1';
    if (catNameInput) catNameInput.value = '';
    if (catSlugInput) catSlugInput.value = '';
    if (catModalTitle) catModalTitle.textContent = 'Add Navbar Category';
    catModal?.classList.remove('opacity-0', 'pointer-events-none');
  });

  document.getElementById('close-cat-modal')?.addEventListener('click', () => {
    catModal?.classList.add('opacity-0', 'pointer-events-none');
  });
  document.getElementById('cancel-cat-btn')?.addEventListener('click', () => {
    catModal?.classList.add('opacity-0', 'pointer-events-none');
  });

  // Auto-generate slug when adding a new category
  catNameInput?.addEventListener('input', () => {
    if (!editCatIdInput?.value) {
      catSlugInput.value = catNameInput.value.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
    }
  });

  // Attach all action listeners to categories and subcategories
  function attachCategoryListeners() {
    // Edit Main Category
    document.querySelectorAll<HTMLButtonElement>('.btn-edit-main-cat').forEach(b => {
      b.onclick = (e) => {
        const btn = e.currentTarget as HTMLElement;
        const card = btn.closest('.cat-card') as HTMLElement;
        if (!card) return;

        const catId = card.getAttribute('data-cat-id') || '';
        const catName = card.getAttribute('data-cat-name') || card.querySelector('.cat-title')?.textContent?.trim() || '';
        const catSlug = card.querySelector('.cat-slug')?.textContent?.replace('/', '').trim() || '';

        if (editCatIdInput) editCatIdInput.value = catId;
        if (editCatIndexInput) editCatIndexInput.value = card.getAttribute('data-cat-idx') || '0';
        if (catNameInput) catNameInput.value = catName;
        if (catSlugInput) catSlugInput.value = catSlug;
        if (catModalTitle) catModalTitle.textContent = `Edit Category: ${catName}`;
        catModal?.classList.remove('opacity-0', 'pointer-events-none');
      };
    });

    // Delete Main Category (Opens Confirmation Modal)
    document.querySelectorAll<HTMLButtonElement>('.btn-delete-main-cat').forEach(b => {
      b.onclick = (e) => {
        const btn = e.currentTarget as HTMLElement;
        const card = btn.closest('.cat-card') as HTMLElement;
        if (!card) return;

        const catId = card.getAttribute('data-cat-id') || '';
        const catName = card.getAttribute('data-cat-name') || card.querySelector('.cat-title')?.textContent?.trim() || 'this category';

        pendingDeleteAction = {
          type: 'category',
          catId,
          domTarget: card
        };

        const modalDesc = delModal?.querySelector('.modal-delete-desc');
        if (modalDesc) modalDesc.textContent = `Are you sure you want to delete category "${catName}" and all its subcategories?`;
        delModal?.classList.remove('opacity-0', 'pointer-events-none');
      };
    });

    // Add Subcategory Button (Opens Subcategory Modal)
    document.querySelectorAll<HTMLButtonElement>('.btn-add-subcat').forEach(b => {
      b.onclick = (e) => {
        const btn = e.currentTarget as HTMLElement;
        const card = btn.closest('.cat-card') as HTMLElement;
        if (!card) return;

        const catId = card.getAttribute('data-cat-id') || '';
        const catName = card.getAttribute('data-cat-name') || card.querySelector('.cat-title')?.textContent?.trim() || '';

        if (targetCatIdInput) targetCatIdInput.value = catId;
        if (targetCatIdxInput) targetCatIdxInput.value = card.getAttribute('data-cat-idx') || '0';
        if (subNameInput) subNameInput.value = '';
        if (subModalTitle) subModalTitle.textContent = `Add Subcategory under ${catName}`;
        subModal?.classList.remove('opacity-0', 'pointer-events-none');
      };
    });

    // Delete Subcategory (Opens Confirmation Modal)
    document.querySelectorAll<HTMLButtonElement>('.btn-del-sub').forEach(b => {
      b.onclick = (e) => {
        e.stopPropagation();
        const btn = e.currentTarget as HTMLElement;
        const pill = btn.closest('.subcat-pill') as HTMLElement;
        const card = btn.closest('.cat-card') as HTMLElement;
        if (!pill) return;

        const catId = pill.getAttribute('data-cat-id') || card?.getAttribute('data-cat-id') || '';
        const subId = pill.getAttribute('data-sub-id') || '';
        const subName = pill.getAttribute('data-sub-name') || pill.querySelector('.sub-name')?.textContent?.trim() || 'this subcategory';

        pendingDeleteAction = {
          type: 'subcategory',
          catId,
          subId,
          subName,
          domTarget: pill
        };

        const modalDesc = delModal?.querySelector('.modal-delete-desc');
        if (modalDesc) modalDesc.textContent = `Remove subcategory "${subName}" from navigation dropdown?`;
        delModal?.classList.remove('opacity-0', 'pointer-events-none');
      };
    });
  }

  // Delete Modal: Cancel
  delModal?.querySelector('.modal-delete-cancel')?.addEventListener('click', () => {
    delModal.classList.add('opacity-0', 'pointer-events-none');
    pendingDeleteAction = null;
  });

  // Delete Modal: Confirm Action
  delModal?.querySelector('.modal-delete-confirm')?.addEventListener('click', async () => {
    if (!pendingDeleteAction) {
      delModal.classList.add('opacity-0', 'pointer-events-none');
      return;
    }

    try {
      if (pendingDeleteAction.type === 'category' && pendingDeleteAction.catId) {
        await deleteCategory(pendingDeleteAction.catId);
      } else if (pendingDeleteAction.type === 'subcategory') {
        await (deleteSubcategory as any)(
          pendingDeleteAction.subId || null, 
          pendingDeleteAction.catId, 
          pendingDeleteAction.subName || null
        );
      }

      if (pendingDeleteAction.domTarget) {
        pendingDeleteAction.domTarget.remove();
      }

      if (typeof (window as any).refreshCategories === 'function') {
        await (window as any).refreshCategories();
      }
    } catch (err: any) {
      console.error('Error executing delete action:', err);
    } finally {
      pendingDeleteAction = null;
      delModal.classList.add('opacity-0', 'pointer-events-none');
    }
  });

  // Handle Category Form Submit (Add or Edit)
  catForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const existingId = editCatIdInput?.value?.trim();
    const name = catNameInput.value.trim();
    const slug = catSlugInput.value.trim();
    const catId = existingId ? existingId : `cat-${slug.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;

    catModal?.classList.add('opacity-0', 'pointer-events-none');

    try {
      await saveCategory({
        id: catId,
        name,
        slug,
        status: 'Active',
        sort_order: 1
      });

      if (typeof (window as any).refreshCategories === 'function') {
        await (window as any).refreshCategories();
      }
    } catch (err: any) {
      console.error('Save category error:', err);
    }
  });

  // Handle Subcategory Form Submit
  subForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const catId = targetCatIdInput?.value?.trim();
    const subName = subNameInput.value.trim();

    subModal?.classList.add('opacity-0', 'pointer-events-none');

    if (catId && subName) {
      try {
        await saveSubcategory({
          category_id: catId,
          name: subName,
          slug: subName.toLowerCase().replace(/[^a-z0-9]+/g, '-')
        });

        if (typeof (window as any).refreshCategories === 'function') {
          await (window as any).refreshCategories();
        }
      } catch (err: any) {
        console.error('Save subcategory error:', err);
      }
    }
  });

  document.getElementById('close-subcat-modal')?.addEventListener('click', () => {
    subModal?.classList.add('opacity-0', 'pointer-events-none');
  });
  document.getElementById('cancel-subcat-btn')?.addEventListener('click', () => {
    subModal?.classList.add('opacity-0', 'pointer-events-none');
  });

  // Client-side fetch & render live categories from Supabase
  (window as any).refreshCategories = async function() {
    try {
      const liveCats = await getNavbarCategoriesWithSubcategories();
      if (liveCats && liveCats.length > 0) {
        const grid = document.getElementById('cat-cards-grid');
        if (grid) {
          grid.innerHTML = '';
          liveCats.forEach((cat: any, catIdx: number) => {
            const card = document.createElement('div');
            card.id = `cat-card-${catIdx}`;
            card.className = 'cat-card bg-white rounded-2xl border border-neutral-200/80 p-5 shadow-xs space-y-4 hover:border-black transition-colors';
            card.setAttribute('data-cat-name', cat.name);
            card.setAttribute('data-cat-id', cat.id);
            card.setAttribute('data-cat-idx', catIdx.toString());

            const subs = cat.subcategories || [];
            const subPills = subs.map((sub: any) => `
              <span class="subcat-pill inline-flex items-center gap-1.5 text-xs bg-neutral-50 text-neutral-800 border border-neutral-200 px-2.5 py-1 rounded-lg font-medium hover:bg-neutral-100 transition-colors" data-cat-id="${cat.id}" data-sub-id="${sub.id || ''}" data-sub-name="${sub.name}">
                <span class="sub-name">${sub.name}</span>
                <button type="button" class="btn-del-sub text-neutral-400 hover:text-red-500 text-xs ml-0.5" title="Remove subcategory">×</button>
              </span>
            `).join('');

            card.innerHTML = `
              <div class="flex items-start justify-between border-b pb-3">
                <div>
                  <div class="flex items-center gap-2">
                    <h3 class="cat-title text-base font-bold text-[#000104]">${cat.name}</h3>
                    <span class="cat-slug text-[10px] font-bold px-2 py-0.5 rounded-full bg-neutral-100 text-neutral-700 font-mono">
                      /${cat.slug}
                    </span>
                  </div>
                  <p class="cat-count text-xs text-[#5E666C] mt-0.5">Active category in navigation</p>
                </div>
                <div class="flex items-center gap-2">
                  <span class="px-2 py-0.5 rounded text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">${cat.status || 'Active'}</span>
                  <button type="button" class="btn-edit-main-cat text-xs font-semibold text-neutral-500 hover:text-black underline" data-idx="${catIdx}">Edit</button>
                  <button type="button" class="btn-delete-main-cat text-xs font-semibold text-red-500 hover:text-red-700 underline" data-idx="${catIdx}">Delete</button>
                </div>
              </div>
              <div>
                <div class="flex items-center justify-between mb-2">
                  <span class="subcat-header text-[11px] font-bold text-neutral-400 uppercase tracking-wider">Dropdown Subcategories (${subs.length})</span>
                  <button type="button" class="btn-add-subcat text-[11px] font-semibold text-black hover:underline" data-idx="${catIdx}" data-cat="${cat.name}">+ Add Subcategory</button>
                </div>
                <div class="subcat-list flex flex-wrap gap-1.5" data-cat-idx="${catIdx}">
                  ${subPills}
                </div>
              </div>
            `;
            grid.appendChild(card);
          });
          attachCategoryListeners();
        }
      }
    } catch (e) {
      console.warn('Live categories warning:', e);
    }
  };

  // Initial load
  (window as any).refreshCategories();
  attachCategoryListeners();
</script>
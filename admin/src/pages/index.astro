---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminStatsGrid from '../components/AdminStatsGrid.astro';
import AdminOrdersTable from '../components/AdminOrdersTable.astro';
import { initialProducts } from '../data/storeDataModel.js';
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  
  <!-- 1. KPI Stats Grid (Total Sales, Total Orders, Active Deliveries, Low Stock) -->
  <AdminStatsGrid />

  <!-- 2. Clean Work Area: Recent Orders & Quick Stock Alert -->
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 items-start">
    
    <!-- Left Column: Recent Orders Table -->
    <div class="xl:col-span-2 space-y-6">
      <AdminOrdersTable limit={5} showFilters={true} />
    </div>

    <!-- Right Column: Clean Stock Alert Card & Quick Actions -->
    <div class="space-y-6">
      
      <!-- Quick Actions Card -->
      <div class="bg-white rounded-2xl border border-neutral-200/80 p-5 shadow-xs space-y-3">
        <h4 class="font-bold text-sm text-[#000104]">Quick Actions</h4>
        <div class="grid grid-cols-2 gap-2 text-xs">
          <a href="/products" class="p-3 rounded-xl border border-neutral-200 hover:border-black font-semibold text-center bg-neutral-50 hover:bg-white transition-colors block">
            + Add Product
          </a>
          <a href="/categories" class="p-3 rounded-xl border border-neutral-200 hover:border-black font-semibold text-center bg-neutral-50 hover:bg-white transition-colors block">
            + Category
          </a>
          <a href="/banner" class="p-3 rounded-xl border border-neutral-200 hover:border-black font-semibold text-center bg-neutral-50 hover:bg-white transition-colors block">
            Hero Banners
          </a>
          <a href="/orders" class="p-3 rounded-xl border border-neutral-200 hover:border-black font-semibold text-center bg-neutral-50 hover:bg-white transition-colors block">
            All Orders
          </a>
        </div>
      </div>

      <!-- Inventory Low Stock Alerts -->
      <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-xs p-5 space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="font-bold text-sm text-[#000104]">Inventory Attention</h4>
          <a href="/products" class="text-xs text-neutral-500 hover:text-black font-semibold">View All →</a>
        </div>
        <div class="divide-y divide-neutral-100 text-xs">
          {initialProducts.filter(p => p.stock <= 6).map(prod => (
            <div class="py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src={prod.image} alt="" class="w-8 h-8 object-contain bg-[#FAF8F5] rounded border p-0.5" />
                <div>
                  <span class="font-bold block text-neutral-900">{prod.name}</span>
                  <span class="text-[10px] text-neutral-400 font-mono">{prod.sku}</span>
                </div>
              </div>
              <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-100 text-amber-800">
                {prod.stock} Left
              </span>
            </div>
          ))}
        </div>
      </div>

    </div>

  </div>

</AdminLayout>

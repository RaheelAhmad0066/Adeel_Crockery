---
import AdminLayout from '../layouts/AdminLayout.astro';
import AdminStatsGrid from '../components/AdminStatsGrid.astro';
import AdminOrdersTable from '../components/AdminOrdersTable.astro';
import AdminDispatchRadar from '../components/AdminDispatchRadar.astro';
import { adminProductsList } from '../data/adminMockData.js';
---

<AdminLayout title="Dashboard" activeNav="dashboard">
  
  <!-- 1. KPI Stats Grid -->
  <AdminStatsGrid />

  <!-- 2. Main Work Area: Orders Table & Dispatch Radar -->
  <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 items-start">
    
    <!-- Left Column: Recent Orders (Foodpanda Live Tracker Statuses) -->
    <div class="xl:col-span-2 space-y-6">
      <AdminOrdersTable limit={5} showFilters={true} />
    </div>

    <!-- Right Column: Live Dispatch Radar & Low Stock Warnings -->
    <div class="space-y-6">
      <!-- Live Foodpanda Tracker Radar Card -->
      <AdminDispatchRadar />

      <!-- Quick Inventory Alert Card -->
      <div class="bg-white rounded-2xl border border-neutral-200/80 shadow-sm p-5 sm:p-6 space-y-3">
        <div class="flex items-center justify-between">
          <h4 class="font-bold text-sm text-[#000104]">Inventory Alerts</h4>
          <a href="/admin/products" class="text-xs text-neutral-500 hover:text-black font-semibold">Manage →</a>
        </div>
        <div class="divide-y divide-neutral-100 text-xs">
          {adminProductsList.filter(p => p.stock <= 5).map(prod => (
            <div class="py-2.5 flex items-center justify-between">
              <div class="flex items-center gap-2.5">
                <img src={prod.image} alt="" class="w-8 h-8 object-contain bg-[#FAF8F5] rounded border p-0.5" />
                <div>
                  <span class="font-bold block text-neutral-900">{prod.name}</span>
                  <span class="text-[10px] text-neutral-400 font-mono">{prod.sku}</span>
                </div>
              </div>
              <span class={`px-2 py-0.5 rounded-full text-[10px] font-bold ${prod.stock === 0 ? 'bg-red-100 text-red-700' : 'bg-amber-100 text-amber-700'}`}>
                {prod.stock === 0 ? 'Out of Stock' : `${prod.stock} Left`}
              </span>
            </div>
          ))}
        </div>
      </div>
    </div>

  </div>

</AdminLayout>

